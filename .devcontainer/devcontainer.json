// Dev container for HAL-C2. Mirrors CI (ubuntu-24.04, Node 24, Rust stable)
// and the canonical setup in docs/operations/development.md: global `vp`, `vp i`.
// Contributor doc: docs/internals/devcontainer.md
{
  "name": "HAL-C2",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    // native/resource-monitor (edition 2024, needs stable >= 1.85):
    // `vp run build:resource-monitor` and `vp run test:resource-monitor`.
    "ghcr.io/devcontainers/features/rust:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    // Keep all runtime state inside the (gitignored) workspace .hal-c2, matching
    // the worktree default. An explicit --home-dir still wins.
    "HAL_C2_HOME": "${containerWorkspaceFolder}/.hal-c2"
  },
  "remoteEnv": {
    // mise's shims, appended, put the mise.toml tools nothing earlier on PATH
    // provides (mix, elixir, erl, bun) on PATH for terminals, extensions and
    // tasks, not only inside `mise run`/`mise exec`. Bare `node` intentionally
    // stays the devcontainer feature's Node 24 (`mise run` gets mise.toml's
    // pinned node); prepending would also make shims error outside a config
    // directory ("No version is set for shim").
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/share/mise/shims"
  },
  "mounts": [
    // vp keeps the pnpm content-addressable store and metadata cache under
    // ~/.cache/pnpm (verified: the v11 store dir lives there); mounting a
    // volume there lets installs survive container rebuilds.
    "source=hal-c2-pnpm-store,target=/home/vscode/.cache/pnpm,type=volume",
    // Root node_modules holds the whole pnpm virtual store (.pnpm), so one
    // volume keeps the heavy tree off the slow macOS/Windows bind mount.
    // Scoped by devcontainerId so parallel checkouts do not share it.
    // Codespaces note: prebuild snapshots exclude volumes; drop these mounts
    // if prebuilt codespaces become the primary workflow.
    "source=hal-c2-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "onCreateCommand": "bash .devcontainer/on-create.sh",
  "updateContentCommand": "bash .devcontainer/update-content.sh",
  "forwardPorts": [3780],
  "portsAttributes": {
    "3780": {
      "label": "hal-c2 MC",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/internals/devcontainer.md"]
    },
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "rust-lang.rust-analyzer"],
      "settings": {
        "files.watcherExclude": {
          "**/.hal-c2/**": true
        }
      }
    }
  },
  "remoteUser": "vscode"
}
