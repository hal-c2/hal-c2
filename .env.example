# Optional: HAL-C2 Connect source builds
# HAL-C2 ships no hosted Connect deployment, so these are empty by default and
# cloud features stay disabled. To enable Connect, `cp .env.example .env` and
# fill them in from your own Clerk instance and relay deployment.
# Do not add server-side secrets to this file.

# Your Clerk instance: the Clerk Dashboard lists these under API keys, JWT
# templates, and OAuth applications. They must come from your own instance.
HAL_C2_CLERK_PUBLISHABLE_KEY=
HAL_C2_CLERK_JWT_TEMPLATE=hal-c2-relay
HAL_C2_CLERK_CLI_OAUTH_CLIENT_ID=

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in HAL_C2_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# HAL_C2_APPLE_TEAM_ID=ABC1234567
# HAL_C2_MACOS_PROVISIONING_PROFILE=/absolute/path/to/hal-c2.provisionprofile
# HAL_C2_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Your relay deployment. `infra/relay` deploys update it automatically.
HAL_C2_RELAY_URL=

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.hal-c2.example; override to test against a staging deployment.
# HAL_C2_HOSTED_APP_URL=https://nightly.app.hal-c2.example

# Public, ingest-only mobile OpenTelemetry configuration.
# HAL_C2_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# HAL_C2_MOBILE_OTLP_TRACES_DATASET=hal-c2-mobile-traces-dev
# HAL_C2_MOBILE_OTLP_TRACES_TOKEN=xaat-...
