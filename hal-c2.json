{
  "$schema": "https://hal-c2.example/schema/hal-c2.json",
  "iconPath": "assets/dev/blueprint-universal-1024.png",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "mise trust && vp i && ln -sf \"$HAL_C2_PROJECT_ROOT/.env\" .env && (cd apps/server-ex && mise exec -- mix deps.get)",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Setup Worktree (Windows)",
      "command": "vp i && New-Item -ItemType SymbolicLink -Path .env -Target \"$env:HAL_C2_PROJECT_ROOT\\.env\" -Force",
      "icon": "configure",
      "runOnWorktreeCreate": true
    }
  ]
}
