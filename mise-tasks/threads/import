#!/usr/bin/env bash
#MISE description="Pick threads from T3 Code or an older HAL-C2 on this machine and import them into the running dev MC (mix hal_c2.threads.import); --release imports into the installed MC"
#MISE dir="{{config_root}}/apps/server-ex"
#USAGE flag "--release" help="Import into the installed MC (the hal-c2 service) instead of the dev MC"
set -euo pipefail
if [[ ${usage_release:-false} == true ]]; then
  exec mix hal_c2.threads.import --release
fi
exec mix hal_c2.threads.import
