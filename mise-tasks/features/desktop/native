#!/usr/bin/env bash
#MISE description="Build (when needed) and run the Qt desktop's native tests with ctest"
#MISE dir="{{config_root}}"
set -euo pipefail
"$MISE_CONFIG_ROOT/mise-tasks/deps/check" --require native >/dev/null
build=apps/desktop-qt/build/tests/native
# A configure cut off leaves CMakeCache.txt without the build files.
[[ -f $build/Makefile || -f $build/build.ninja ]] || cmake -S apps/desktop-qt/tests/native -B "$build"
cmake --build "$build" --parallel "${HAL_C2_BUILD_JOBS:-$(( ($(getconf _NPROCESSORS_ONLN) + 1) / 2 ))}"
exec ctest --test-dir "$build" --output-on-failure
