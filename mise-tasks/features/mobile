#!/usr/bin/env bash
#MISE description="Build (when needed) and run the QML phone client's tests with ctest: its scenarios against a fake MC, and its pairing"
#MISE dir="{{config_root}}"
#USAGE flag "--backlog" help="Run the @backlog and @backlog-mobile scenarios instead, which are expected to fail (or set HAL_C2_BACKLOG=1)"
#USAGE arg "[glob]" var=#true help="Feature globs relative to features/, e.g. mobile/composer.feature; the runner's own list when none"
set -euo pipefail
"$MISE_CONFIG_ROOT/mise-tasks/deps/check" --require native >/dev/null
globs=()
for arg in "$@"; do
  if [[ $arg == --backlog ]]; then export HAL_C2_BACKLOG=1; else globs+=("$arg"); fi
done
((${#globs[@]} == 0)) || export HAL_C2_FEATURES="${globs[*]}"
build=apps/mobile-qt/build/tests
if [[ ! -f $build/CMakeCache.txt ]]; then
  # QT_PREFIX or CMAKE_PREFIX_PATH says where Qt 6 lives; the default is qmake6's on PATH, then Homebrew's.
  qt=${QT_PREFIX:-${CMAKE_PREFIX_PATH:-$(qmake6 -query QT_INSTALL_PREFIX 2>/dev/null || brew --prefix qt 2>/dev/null || true)}}
  cmake -S apps/mobile-qt/tests -B "$build" -DCMAKE_BUILD_TYPE=Release ${qt:+"-DCMAKE_PREFIX_PATH=$qt"}
fi
cmake --build "$build" --parallel
exec ctest --test-dir "$build" --output-on-failure
