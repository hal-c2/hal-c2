#!/usr/bin/env bash
#MISE description="Pick random backlog scenarios to work on, weighted by @priority-high and @priority-low"
#MISE dir="{{config_root}}/features"
#USAGE arg "[filter]" var=#true help="A count (default 1), @tag to require, -@tag to exclude, or a file, directory or glob under features/"
# A scenario is backlog work when it is @backlog, or @backlog-<surface> for a surface it has.
# Asking for a surface (@node, @desktop, @mobile, @tui) keeps only work still missing there;
# @shared counts as each client. A high-priority scenario is four times as likely as a low
# one and twice a plain one, so low-priority work still comes up. Prints file:line, the
# scenario, its tags and its steps.
set -euo pipefail
shopt -s globstar nullglob

count=1 want="" skip="" paths=()
for arg in "$@"; do
  case $arg in
    -@*) skip+=" ${arg#-}" ;;
    @*) want+=" $arg" ;;
    "" | -*) echo "features:pick: expected a count, @tag, -@tag or path, got '$arg'" >&2; exit 2 ;;
    *[!0-9]*)
      matches=($arg)
      [[ -e ${matches[0]:-} ]] || { echo "features:pick: nothing under features/ matches $arg" >&2; exit 2; }
      paths+=("${matches[@]}") ;;
    *) count=$arg ;;
  esac
done
((${#paths[@]})) || paths=(.)

find "${paths[@]}" -name '*.feature' | sed 's|^\./||' | sort -u | xargs awk -v want="$want" -v skip="$skip" -v seed="$RANDOM" '
  BEGIN {
    srand(seed); n = split(want, wanted, " "); m = split(skip, skipped, " ")
    for (i = 1; i <= n; i++) if (wanted[i] ~ /^@(node|desktop|mobile|tui)$/) surfaces = surfaces " " substr(wanted[i], 2)
  }
  FNR == 1 { flush(); pending = feature = rule = scenario = steps = ""; in_steps = 0 }
  /^[[:space:]]*@/ { line = $0; sub(/#.*/, "", line); pending = pending " " line; next }
  /^[[:space:]]*Feature:/ { flush(); feature = pending; pending = ""; in_steps = 0; next }
  /^[[:space:]]*Rule:/ { flush(); rule = pending; pending = ""; in_steps = 0; next }
  /^[[:space:]]*(Scenario|Scenario Outline|Example):/ {
    flush()
    tags = feature " " rule " " pending " "; pending = ""
    name = $0; sub(/^[[:space:]]*/, "", name)
    scenario = tags; outline_name = name; steps = ""; in_steps = 1
    if (backlogged(tags)) consider(tags, FILENAME ":" FNR, name)
    next
  }
  # An outline that is not backlog work can still carry backlog Examples tables; each one
  # is its own piece of work.
  /^[[:space:]]*Examples:/ {
    flush(); in_steps = 0
    if (backlogged(" " pending " ") && !backlogged(scenario)) {
      name = $0; sub(/^[[:space:]]*/, "", name)
      consider(scenario pending " ", FILENAME ":" FNR, outline_name " / " name); flush()
    }
    pending = ""; next
  }
  in_steps && /^[[:space:]]*(Given|When|Then|And|But|\*) / { step = $0; sub(/^[[:space:]]*/, "", step); steps = steps "\037" step }
  END { flush() }
  function backlogged(tags,   i, sv) {
    if (tags ~ / @backlog /) return 1
    if (surfaces == "") return tags ~ / @backlog-(node|desktop|mobile|tui) /
    for (i = split(surfaces, sv, " "); i > 0; i--) if (index(tags, " @backlog-" sv[i] " ")) return 1
    return 0
  }
  function consider(tags, at, name,   i, t, w) {
    if (tags ~ / @dropped /) return
    for (i = 1; i <= n; i++) {
      t = wanted[i]
      if (index(tags, " " t " ") == 0 && !(t ~ /^@(desktop|mobile|tui)$/ && tags ~ / @shared /)) return
    }
    for (i = 1; i <= m; i++) if (index(tags, " " skipped[i] " ")) return
    w = tags ~ / @priority-high / ? 4 : tags ~ / @priority-low / ? 1 : 2
    gsub(/[[:space:]]+/, " ", tags); sub(/^ /, "", tags); sub(/ $/, "", tags)
    # Weighted sampling without replacement: the largest u^(1/w) keys win.
    held = sprintf("%.12f\tfeatures/%s\t%s\t%s", rand() ^ (1 / w), at, name, tags)
  }
  # A candidate is printed once its steps have been read.
  function flush() {
    if (held != "") print held "\t" steps
    held = ""
  }
' | sort -rn | awk -F'\t' -v count="$count" 'NR <= count {
  printf "%s%s\n  %s\n  %s\n", (NR > 1 ? "\n" : ""), $2, $3, $4
  n = split($5, steps, "\037")
  for (i = 2; i <= n; i++) printf "    %s\n", steps[i]
}'
