#!/usr/bin/env bash
#MISE description="Pick random @backlog scenarios to work on, weighted by @priority-high and @priority-low"
#MISE dir="{{config_root}}/features"
#USAGE arg "[count]" help="How many scenarios to pick (default 1)"
#USAGE arg "[tag]" var=#true help="Only scenarios carrying every one of these tags, e.g. @node (@shared counts as each client)"
# A high-priority scenario is four times as likely as a low one and twice a plain one, so
# low-priority work still comes up. Prints file:line, the scenario and its tags.
set -euo pipefail

count=1 want=""
for arg in "$@"; do
  case $arg in
    @*) want+=" $arg" ;;
    *[!0-9]* | "") echo "features:pick: expected a count or a @tag, got $arg" >&2; exit 2 ;;
    *) count=$arg ;;
  esac
done

find . -name '*.feature' | sed 's|^\./||' | sort | xargs awk -v want="$want" -v seed="$RANDOM" '
  BEGIN { srand(seed); n = split(want, wanted, " ") }
  FNR == 1 { pending = feature = rule = scenario = "" }
  /^[[:space:]]*@/ { line = $0; sub(/#.*/, "", line); pending = pending " " line; next }
  /^[[:space:]]*Feature:/ { feature = pending; pending = ""; next }
  /^[[:space:]]*Rule:/ { rule = pending; pending = ""; next }
  /^[[:space:]]*(Scenario|Scenario Outline|Example):/ {
    tags = feature " " rule " " pending " "; pending = ""
    name = $0; sub(/^[[:space:]]*/, "", name); at = FILENAME ":" FNR
    scenario = tags; if (tags ~ / @backlog /) consider(tags, at, name)
    else { outline_at = at; outline_name = name }
    next
  }
  # An outline whose own tags are not @backlog can still carry a @backlog Examples table.
  /^[[:space:]]*Examples:/ {
    if (pending ~ /@backlog/ && scenario !~ / @backlog /) { consider(scenario pending " ", outline_at, outline_name); outline_at = "" }
    pending = ""; next
  }
  function consider(tags, at, name,   i, t, w) {
    if (at == "" || tags ~ / @dropped /) return
    for (i = 1; i <= n; i++) {
      t = wanted[i]
      if (index(tags, " " t " ") == 0 && !(t ~ /^@(desktop|mobile|tui)$/ && tags ~ / @shared /)) return
    }
    w = tags ~ / @priority-high / ? 4 : tags ~ / @priority-low / ? 1 : 2
    gsub(/[[:space:]]+/, " ", tags); sub(/^ /, "", tags); sub(/ $/, "", tags)
    # Weighted sampling without replacement: the largest u^(1/w) keys win.
    printf "%.12f\tfeatures/%s\t%s\t%s\n", rand() ^ (1 / w), at, name, tags
  }
' | sort -rn | awk -F'\t' -v count="$count" 'NR <= count { printf "%s\n  %s\n  %s\n", $2, $3, $4 }'
