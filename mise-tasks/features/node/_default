#!/usr/bin/env bash
#MISE description="Run @node scenarios for the given globs on the Elixir node (mix features)"
#MISE dir="{{config_root}}/apps/server-ex"
#USAGE arg "[glob]" var=#true help="Feature globs relative to features/, e.g. threads/*.feature"
# `mix features` runs `mix test --only cucumber`, and that include wins over the
# backlog exclude: @backlog scenarios always run here, and fail by design.
set -euo pipefail

if (($# == 0)); then
  cat >&2 <<'USAGE'
usage: mise run features:node <glob>...

Globs are relative to features/, e.g. `mise run features:node 'threads/*.feature'`.
They are required: the whole suite in one run is slow. `mise run features:node:all`
runs it one top-level directory at a time. @backlog scenarios run too and fail by design.
USAGE
  exit 2
fi

exec mix features "$@"
