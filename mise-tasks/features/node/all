#!/usr/bin/env bash
#MISE description="Run every @node scenario, one mix features per top-level features/ directory"
#MISE dir="{{config_root}}/apps/server-ex"
# @backlog scenarios run too and fail by design; see features:node.
set -euo pipefail

log=$(mktemp)
trap 'rm -f "$log"' EXIT

results=() failed=() passed=0 ran=0
for dir in ../../features/*/; do
  name=$(basename "$dir")
  grep -rqs --include='*.feature' '@node' "$dir" || continue
  echo "==> features/$name"
  status=ok
  mix features "$name/**/*.feature" 2>&1 | tee "$log" || { status=FAILED; failed+=("$name"); }
  result=$(grep '^Result:' "$log" | tail -n1 || true)
  results+=("$(printf '%-16s %-7s %s' "$name" "$status" "${result:-Result: none (the run did not finish)}")")
  # "Result: 19 passed, ..." when all pass, "Result: 925/1103 passed, ..." otherwise.
  if [[ $result =~ ([0-9]+)/([0-9]+)\ passed ]]; then
    passed=$((passed + BASH_REMATCH[1])) ran=$((ran + BASH_REMATCH[2]))
  elif [[ $result =~ ([0-9]+)\ passed ]]; then
    passed=$((passed + BASH_REMATCH[1])) ran=$((ran + BASH_REMATCH[1]))
  fi
done

echo
printf '%s\n' "${results[@]}"
echo "Tally: $passed/$ran scenarios passed; $((${#results[@]} - ${#failed[@]}))/${#results[@]} directories passed"
((${#failed[@]} == 0)) || { echo "Failed: ${failed[*]}" >&2; exit 1; }
