#!/usr/bin/env bash
#MISE description="Compile and load changed modules into the running dev MC without a restart (mix hal_c2.upgrade --dev [MC ...]); --release builds a release and moves the installed MC to it"
#MISE dir="{{config_root}}/apps/server-ex"
#USAGE flag "--release" help="Update the installed MC (the hal-c2 service) instead of the dev MC, in place when the change allows"
#USAGE flag "--root <root>" help="With --release: the HAL_C2_HOME root the installed MC keeps its files under, when it is not in the default location (not a HAL_C2_MC_HOME directory, which `mise run mc --home` takes)"
#USAGE arg "[mcs]..." help="Dev MCs to reload by node name instead of the local one"
set -euo pipefail
if [[ ${usage_release:-false} == true ]]; then
  if [[ -n ${usage_root:-} ]]; then
    exec mix hal_c2.upgrade --release --root "$usage_root"
  fi
  exec mix hal_c2.upgrade --release
fi
if [[ -n ${usage_root:-} ]]; then
  echo "--root goes with --release" >&2
  exit 2
fi
# shellcheck disable=SC2086 # usage joins the names with spaces
exec mix hal_c2.upgrade --dev ${usage_mcs:-}
