#!/usr/bin/env bash
#MISE description="Open the terminal client on the running MC (this checkout's mise run mc, --base-dir <root>, or --url <pairing link> for a remote one)"
#MISE dir="{{config_root}}"
#MISE depends=["tui:build"]
set -euo pipefail
args=("$@")
if [[ " $* " != *" --base-dir"* && -z ${HAL_C2_MC_HOME:-} ]]; then
  # `mise run mc` keeps its runtime record and access token in the XDG hal-c2-dev
  # profile (apps/server-ex/config/config.exs).
  args=(--dev ${args[@]+"${args[@]}"})
fi
# ${args[@]+…}: an empty array under set -u is an error on macOS bash 3.2.
exec bun apps/tui/dist/index.js ${args[@]+"${args[@]}"}
