#!/usr/bin/env bash
#MISE description="Bundle the terminal client and open it on the running Elixir node (--base-dir defaults to ./.hal-c2, --url <pairing link> for a remote one)"
#MISE dir="{{config_root}}"
set -euo pipefail
(cd apps/tui && bun run --silent build >/dev/null)
args=("$@")
if [[ " $* " != *" --base-dir"* && " $* " != *" --url"* && -z ${HAL_C2_NODE_HOME:-} ]]; then
  # A checkout's node (`mise run node`) keeps its runtime record and access token
  # under <checkout>/.hal-c2 (apps/server-ex/config/config.exs).
  args=(--base-dir "$PWD/.hal-c2" "${args[@]}")
fi
exec bun apps/tui/dist/index.js "${args[@]}"
