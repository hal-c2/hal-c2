#!/usr/bin/env bash
#MISE description="Open the terminal client on the running Elixir node (--base-dir defaults to ./.hal-c2, --url <pairing link> for a remote one)"
#MISE dir="{{config_root}}"
#MISE depends=["tui:build"]
set -euo pipefail
args=("$@")
if [[ " $* " != *" --base-dir"* && " $* " != *" --url"* && -z ${HAL_C2_NODE_HOME:-} ]]; then
  # A checkout's node (`mise run node`) keeps its runtime record and access token
  # under <checkout>/.hal-c2 (apps/server-ex/config/config.exs).
  args=(--base-dir "$PWD/.hal-c2" ${args[@]+"${args[@]}"})
fi
# ${args[@]+…}: an empty array under set -u is an error on macOS bash 3.2.
exec bun apps/tui/dist/index.js ${args[@]+"${args[@]}"}
