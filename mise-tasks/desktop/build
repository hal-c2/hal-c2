#!/usr/bin/env bash
#MISE description="Build the Qt desktop shell and the web app it serves without launching (--release for a Release build); the node is built by install:node"
#MISE dir="{{config_root}}/apps/desktop-qt"
#MISE depends=["web:build"]
set -euo pipefail
exec node scripts/dev-qt.mjs --configure-only "$@"
