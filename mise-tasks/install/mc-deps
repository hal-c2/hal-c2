#!/usr/bin/env bash
#MISE description="Fetch the MC's Elixir deps (apps/server-ex), without compiling; the tasks that run its mix depend on this"
#MISE dir="{{config_root}}/apps/server-ex"
set -euo pipefail
# A fresh Elixir has no Hex or rebar, and mix would stop to ask for them.
mix local.hex --force --if-missing
mix local.rebar --force --if-missing
mix deps.get
