#!/usr/bin/env bash
#MISE description="Build the Linux release into release/: the MC (release:mc) and the Ljós desktop that carries it (release:desktop-ljos)"
#MISE dir="{{config_root}}"
#MISE depends=["release:desktop-ljos"]
set -euo pipefail

[[ $(uname -s) == Linux ]] || {
  echo "release:linux builds on Linux only." >&2
  exit 1
}

# The desktop is desktop-ljos (#1661): release:desktop-ljos lays it out as
# installed — hal-c2-ljos, its helper and CEF's runtime beside each other,
# Node and the MC under share/hal-c2. There is no Qt AppImage anymore.
read -r _ version <apps/server-ex/_build/prod/rel/hal_c2/releases/start_erl.data || true # no trailing newline
arch="$(uname -m)"
out="release/hal-c2-ljos-$version-linux-${arch/x86_64/x64}"
out="${out/aarch64/arm64}"
[[ -d $out ]] || { echo "release:linux: no $out from release:desktop-ljos" >&2; exit 1; }
echo "$out"
