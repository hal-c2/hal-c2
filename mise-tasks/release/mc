#!/usr/bin/env bash
#MISE description="Build the MC release for this machine into release/: the upgrade bundle and the single-file MC whose `install` registers the background service"
#MISE dir="{{config_root}}/apps/server-ex"
#MISE depends=["install:js"]
set -euo pipefail
# install:js: the release bundles the Cursor sidecar with packages/cursor-acp's esbuild.
# On Linux it also builds native/machine-files with cargo into priv/bin.

# A local build is versioned by its commit (scripts/local-version). A single-file MC
# unpacks only a version it has not installed yet. A published release sets HAL_C2_MC_VERSION.
export HAL_C2_MC_VERSION="${HAL_C2_MC_VERSION:-$(scripts/local-version)}"
export MIX_ENV=prod

mix local.hex --force --if-missing
mix local.rebar --force --if-missing
mix deps.get --only prod
# Earlier builds leave their lib/hal_c2-<version> behind, and the bundle packs all of lib/.
# Mix keeps the version of an app it has compiled, so the app's build goes too when it
# was another version's. Read as `built_version/1` in lib/mix/tasks/hal_c2.upgrade.ex
# reads it; change both together.
rm -rf _build/prod/rel/hal_c2
built=$(erl -noshell -eval '
  case file:consult("_build/prod/lib/hal_c2/ebin/hal_c2.app") of
    {ok, [{application, _, Props}]} -> io:put_chars(proplists:get_value(vsn, Props, ""));
    _ -> ok
  end,
  halt().' 2>/dev/null || true)
if [ "$built" != "$HAL_C2_MC_VERSION" ]; then
  rm -rf _build/prod/lib/hal_c2
fi
mix release --overwrite
mix hal_c2.bundle ../../release
