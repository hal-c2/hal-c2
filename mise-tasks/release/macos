#!/usr/bin/env bash
#MISE description="Build the macOS release into release/: the MC (release:mc) and the Ljós desktop app that carries it (release:desktop-ljos)"
#MISE dir="{{config_root}}"
#MISE depends=["release:desktop-ljos"]
set -euo pipefail

[[ $(uname -s) == Darwin ]] || {
  echo "release:macos builds on macOS only." >&2
  exit 1
}

# The desktop is desktop-ljos (#1661): release:desktop-ljos makes the CEF
# bundle (HAL-C2 Ljós.app, deep-signed) around hal-c2-ljos, with Node and
# the MC under Contents/Resources/hal-c2. There is no Qt app zip anymore.
read -r _ version <apps/server-ex/_build/prod/rel/hal_c2/releases/start_erl.data || true # no trailing newline
arch="$(uname -m)"
out="release/hal-c2-ljos-$version-darwin-${arch/x86_64/x64}"
out="${out/aarch64/arm64}"
[[ -d $out ]] || { echo "release:macos: no $out from release:desktop-ljos" >&2; exit 1; }
echo "$out"
