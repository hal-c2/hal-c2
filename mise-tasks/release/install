#!/usr/bin/env bash
#MISE description="Build the release and install it for this user: the MC as the background service and, on x86_64 Linux, the desktop as `hal-c2` with a launcher entry"
#MISE dir="{{config_root}}"
set -euo pipefail

desktop=false
[[ $(uname -s) == Linux && $(uname -m) == x86_64 ]] && desktop=true
if $desktop; then mise run release:linux; else mise run release:mc; fi

read -r _ version <apps/server-ex/_build/prod/rel/hal_c2/releases/start_erl.data || true # no trailing newline
# The single file, beside its .sha256 and its .tar.gz bundle.
mc="$(find release -maxdepth 1 -name "hal-c2-mc-$version-*" ! -name '*.sha256' ! -name '*.tar.gz')"
"$mc" install

$desktop || exit 0
data="${XDG_DATA_HOME:-$HOME/.local/share}"
bin="$HOME/.local/bin/hal-c2"
icons="$data/icons/hicolor/1024x1024/apps"
mkdir -p "$HOME/.local/bin" "$data/applications" "$icons"
# Moved into place, so a running desktop keeps the file it was started from.
cp "release/hal-c2-qt-$version-linux-x64.AppImage" "$bin.new"
mv "$bin.new" "$bin"
cp assets/prod/black-universal-1024.png "$icons/hal-c2.png"
# Named after the shell's app id (hal-c2), so the compositor matches its windows to the entry.
# The desktop finds the service's MC by itself, since both use the same files.
cat >"$data/applications/hal-c2.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=HAL-C2
Exec=$bin
Icon=hal-c2
Categories=Development;
StartupWMClass=hal-c2
DESKTOP
echo "$bin"
