#!/usr/bin/env bash
#MISE description="Build the MC release (release:mc) and install it as this user's background service"
#MISE dir="{{config_root}}"
#MISE depends=["release:mc"]
set -euo pipefail

read -r _ version <apps/server-ex/_build/prod/rel/hal_c2/releases/start_erl.data || true # no trailing newline
# The single file, beside its .sha256 and its .tar.gz bundle, named for the platform
# the release's manifest gives (mix hal_c2.bundle names it so).
platform="$(node -p 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).platform' \
  "apps/server-ex/_build/prod/rel/hal_c2/releases/$version/upgrade.json")"
mc="release/hal-c2-mc-$version-$platform"
[[ -x $mc ]] || { echo "release:install:mc: no $mc to install" >&2; exit 1; }
"$mc" install
