#!/usr/bin/env bash
#MISE description="Build the Qt desktop (release:linux or release:macos) and install it for this user: on x86_64 Linux as `hal-c2` with a launcher entry, on macOS as ~/Applications/HAL-C2.app"
#MISE dir="{{config_root}}"
#MISE depends=["release:{{os()}}"]
set -euo pipefail
# shellcheck source=scripts/lib/replace-install.sh
source scripts/lib/replace-install.sh

read -r _ version <apps/server-ex/_build/prod/rel/hal_c2/releases/start_erl.data || true # no trailing newline

# The desktop finds the service's MC (release:install:mc) by itself, since both use
# the same files, and starts the one it carries when there is none.
if [[ $(uname -s) == Darwin ]]; then
  app="$HOME/Applications/HAL-C2.app"
  mkdir -p "$HOME/Applications"
  # Unpacked beside its place and moved in, so the app is never half there.
  staged_install "$app"
  ditto -x -k release/hal-c2-qt-"$version"-darwin-*.zip "$staging"
  swap_install "$staging/HAL-C2.app"
  echo "$app"
  exit 0
fi

data="${XDG_DATA_HOME:-$HOME/.local/share}"
bin="$HOME/.local/bin/hal-c2"
icons="$data/icons/hicolor/1024x1024/apps"
mkdir -p "$HOME/.local/bin" "$data/applications" "$icons"
# Moved into place, so a running desktop keeps the file it was started from.
cp "release/hal-c2-qt-$version-linux-x64.AppImage" "$bin.new"
mv "$bin.new" "$bin"
cp assets/prod/black-universal-1024.png "$icons/hal-c2.png"
# Named after the shell's app id (hal-c2), so the compositor matches its windows to the entry.
# Quoted and escaped as a desktop entry's Exec wants (a space in HOME splits it otherwise):
# \ " ` $ take a backslash inside the quotes, the file doubles every backslash, % is %%.
exec="\"$(printf '%s' "$bin" | sed -e 's/[\\"`$]/\\&/g' -e 's/\\/\\\\/g' -e 's/%/%%/g')\""
cat >"$data/applications/hal-c2.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=HAL-C2
Exec=$exec
Icon=hal-c2
Categories=Development;
StartupWMClass=hal-c2
DESKTOP
echo "$bin"
