#!/usr/bin/env bash
#MISE description="Build the release and install it for this user: the MC as the background service (release:install:mc) and the desktop (release:install:desktop-ljos) where it builds"
#MISE dir="{{config_root}}"
set -euo pipefail

tasks=(release:install:mc)
case "$(uname -s)" in
  Linux | Darwin) tasks+=(::: release:install:desktop-ljos) ;;
esac
# One run, so the MC release they all carry is built once; one task at a time,
# as each desktop build takes the machine.
exec mise run --jobs 1 "${tasks[@]}"
