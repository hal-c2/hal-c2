{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HAL-C2 plugin manifest",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Lowercase letters, digits and dashes, starting with a letter. The package's directory name."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "apiVersion": {
      "type": "integer"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "homepage": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[\\w./-]+$",
      "description": "A relative path inside the package."
    },
    "screenshots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[\\w./-]+$",
            "description": "A relative path inside the package."
          },
          "caption": {
            "type": "string"
          }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "projects:read",
              "pullRequests:read",
              "pullRequests:write",
              "threads:read",
              "threads:create",
              "agentTools"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why the plugin needs it, shown at consent."
          }
        },
        "required": ["id", "reason"],
        "additionalProperties": false
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["text"]
              },
              "default": {
                "type": "string"
              }
            },
            "required": ["key", "label", "type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["longText"]
              },
              "default": {
                "type": "string"
              }
            },
            "required": ["key", "label", "type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["secret"]
              }
            },
            "required": ["key", "label", "type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["boolean"]
              },
              "default": {
                "type": "boolean"
              }
            },
            "required": ["key", "label", "type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["number"]
              },
              "default": {
                "type": "number"
              }
            },
            "required": ["key", "label", "type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["choice"]
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "disabled": {
                      "type": "boolean"
                    }
                  },
                  "required": ["value", "label"],
                  "additionalProperties": false
                }
              },
              "default": {
                "type": "string"
              }
            },
            "required": ["key", "label", "type", "options"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["list"]
              },
              "default": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["key", "label", "type"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": ["object"]
              },
              "default": {}
            },
            "required": ["key", "label", "type"],
            "additionalProperties": false
          }
        ]
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "type": "string",
                "minLength": 1
              },
              "qml": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[\\w./-]+$",
                "description": "A relative path inside the package."
              }
            },
            "required": ["id", "title", "qml"],
            "additionalProperties": false
          }
        },
        "threadKinds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "rowMark": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[\\w./-]+$",
                "description": "A relative path inside the package."
              },
              "header": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[\\w./-]+$",
                "description": "A relative path inside the package."
              }
            },
            "required": ["kind", "label"],
            "additionalProperties": false
          }
        },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slot": {
                "type": "string",
                "minLength": 1
              },
              "qml": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[\\w./-]+$",
                "description": "A relative path inside the package."
              },
              "order": {
                "type": "integer"
              }
            },
            "required": ["slot", "qml"],
            "additionalProperties": false
          }
        },
        "settingsPage": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[\\w./-]+$",
          "description": "A relative path inside the package."
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["id", "name", "version", "apiVersion", "description"],
  "additionalProperties": false
}
