                    podSeats.push(seat);
                    if (!north)
                        screens.push({
                            key: seat.screen,
                            seat: seat.index,
                            x: seat.x * 16 + 4,
                            y: seat.deskY * 16 + 1,
                            z: (y0 + 3) * 16 + 1
