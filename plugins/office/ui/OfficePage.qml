            const y0 = 6 + 6 * Math.floor(slot / across);
            const x = 3 + slot % across * (podCols + 2);
            const chair = game.pick(game.random(game.hash("chair" + index)), ["#3d4a63", "#4a3d63", "#2f5b52", "#63413d", "#3d5563"]);
