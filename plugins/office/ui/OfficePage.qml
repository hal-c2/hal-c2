                    m(12, 6, 2, 2, tailColor);
                } else {
                    m(13, by - 1 + (f === 2 ? 1 : 0), 2, 2, tailColor);
                }
                const front = f === 1 ? 3 : f === 2 ? 5 : 4;
                const hind = f === 1 ? 11 : f === 2 ? 9 : 10;
                m(front + 2, by + 5, 2, legs - 1, game.shade(base, -0.15));
                m(hind - 2, by + 5, 2, legs - 1, game.shade(base, -0.15));
                m(4, by, 9, 5, base);
                m(front, by + 5, 2, legs, base);
                m(hind, by + 5, 2, legs, base);
                o(front, by + 4 + legs, 2, 1, pawColor);
                o(hind, by + 4 + legs, 2, 1, pawColor);
                head = [1, by - 5, 6, 6];
                m(head[0], head[1], head[2], head[3], base);
                if (cat || L.ears === "up") {
                    m(1, by - 7, 2, 2, earColor);
                    m(4, by - 7, 2, 2, earColor);
                    o(4, by - 6, 1, 1, "#e88a9a");
                }
                if (!cat)
                    m(0, by - 2, 2, 3, L.muzzle ? light : base);
                face = "side";
                marks(L, o, {
                    head: head,
                    body: [4, by, 9, 5],
                    chest: [4, by + 2, 3, 3],
                    muzzle: [0, by - 2, 2, 3],
                    mask: [1, by - 4, 4, 3],
                    saddle: [6, by, 6, 2],
                    paws: [[front, by + 4 + legs, 2, 1], [hind, by + 4 + legs, 2, 1]]
                });
                if (!cat && L.ears !== "up")
                    m(4, by - 5, 2, 5, earColor);
                if (!cat)
                    o(6, by, 1, 4, L.collar);
            } else if (d === 1) {
                // Side, sitting.
                m(11, 19, 4, 2, tailColor);
                m(6, 15, 7, 6, base);
                m(5, 12, 5, 7, base);
                m(5, 18, 2, 3, base);
                o(5, 20, 2, 1, pawColor);
                head = [2, 7, 7, 6];
                m(head[0], head[1], head[2], head[3], base);
                if (cat || L.ears === "up") {
                    m(3, 5, 2, 2, earColor);
                    m(6, 5, 2, 2, earColor);
                }
                if (!cat)
                    m(1, 10, 2, 3, L.muzzle ? light : base);
                face = "side";
                marks(L, o, {
                    head: head,
                    body: [6, 15, 7, 6],
                    chest: [5, 13, 2, 5],
                    muzzle: [1, 10, 2, 3],
                    mask: [2, 8, 4, 3],
                    saddle: [8, 14, 4, 2],
                    paws: [[5, 20, 2, 1]]
                });
                if (!cat && L.ears !== "up")
                    m(6, 7, 2, 5, earColor);
                if (!cat)
                    o(5, 13, 4, 1, L.collar);
                if (f === 4 || f === 10)
                    m(3, 15, 2, 2, pawColor);
            } else {
                // Front or back, sitting (or standing, which looks much the same).
                const backView = d === 3;
                if (cat) {
                    if (backView)
                        m(8, 19, 6, 2, tailColor);
                    else {
                        m(11, 18, 4, 2, tailColor);
                        m(13, 14, 2, 4, tailColor);
                    }
                } else {
                    const wag = (f === 4 || f === 13 || f === 1) ? 1 : 0;
                    m(backView ? 7 + wag : 12 + wag, backView ? 13 : 15, 2, 3, tailColor);
                    if (L.curly && !backView)
                        o(12 + wag, 15, 1, 1, dark);
                }
                m(4, 16, 8, 5, base);
                m(5, 12, 6, 7, base);
                const pawsY = 21 - legs;
                const leftUp = f === 4 || f === 10, rightUp = f === 5 || f === 11;
                m(5, leftUp ? pawsY - 3 : pawsY, 2, legs, base);
                m(9, rightUp ? pawsY - 3 : pawsY, 2, legs, base);
                if (walk) {
                    m(5, f === 1 ? pawsY - 1 : pawsY, 2, legs, base);
                    m(9, f === 2 ? pawsY - 1 : pawsY, 2, legs, base);
                }
                head = [4, 7, 8, 6];
                m(head[0], head[1], head[2], head[3], base);
                if (cat || L.ears === "up") {
                    m(4, 5, 2, 2, earColor);
                    m(10, 5, 2, 2, earColor);
                    if (cat) {
                        m(4, 4, 1, 1, earColor);
                        m(11, 4, 1, 1, earColor);
                    }
                    if (!backView) {
                        o(5, 6, 1, 1, "#e88a9a");
                        o(10, 6, 1, 1, "#e88a9a");
                    }
                }
                if (!cat && !backView)
                    m(6, 10, 4, 3, L.muzzle ? light : (L.face ?? game.shade(base, 0.12)));
                face = backView ? "back" : "front";
                marks(L, o, {
                    head: head,
                    body: [5, 12, 6, 7],
                    chest: backView ? null : [7, 14, 2, 5],
                    muzzle: backView ? null : [6, 10, 4, 3],
                    mask: backView ? null : [5, 8, 6, 4],
                    saddle: backView ? [5, 13, 6, 4] : null,
                    paws: [[5, leftUp ? pawsY - 3 + legs - 1 : 20, 2, 1], [9, rightUp ? pawsY - 3 + legs - 1 : 20, 2, 1]]
                });
                if (!cat && L.ears !== "up") {
                    m(2, 7, 2, 5, earColor);
                    m(12, 7, 2, 5, earColor);
                }
                if (!cat) {
                    o(5, 13, 6, 1, L.collar);
                    if (!backView)
                        o(7, 14, 1, 1, "#f2c94c");
                }
            }
            // Face.
            const eye = L.eye ?? "#2a2226";
            if (face === "front") {
                if (f === 14) {
                    o(5, 9, 2, 1, "#2a2226");
                    o(9, 9, 2, 1, "#2a2226");
                } else if (cat) {
                    o(5, 9, 2, 2, eye);
                    o(9, 9, 2, 2, eye);
                    o(6, 9, 1, 2, "#1b1a20");
                    o(9, 9, 1, 2, "#1b1a20");
                    o(7, 11, 2, 1, "#e88a9a");
                    o(2, 11, 2, 1, "rgba(255,255,255,0.45)");
                    o(12, 11, 2, 1, "rgba(255,255,255,0.45)");
                    if (f === 13)
                        o(7, 12, 2, 1, "#5a2230");
                } else {
                    o(5, 9, 1, 1, eye === "#2a2226" ? eye : eye);
                    o(10, 9, 1, 1, eye);
                    o(7, 10, 2, 1, "#2a2226");
                    o(7, 12, 2, 1, game.shade(L.muzzle ? light : base, -0.4));
                    if (f === 13)
                        m(7, 12, 2, 2, "#ef7d95");
                }
            } else if (face === "side") {
                const hx = head[0], hy = head[1];
                o(hx + 2, hy + 2, 1, cat ? 2 : 1, cat ? eye : "#2a2226");
                if (cat) {
                    o(hx, hy + 4, 1, 1, "#e88a9a");
                    if (f === 13)
                        o(hx, hy + 5, 2, 1, "#5a2230");
                } else {
                    o(hx - 1, hy + 3, 1, 1, "#2a2226");
                    if (f === 13)
                        o(hx, hy + 6, 2, 1, "#ef7d95");
                }
            }
            return [U, M, O];
        }

        // A breed's markings over the anchors a pose names.
        function marks(L, o, a) {
            const dark = L.dark;
            if (L.stripes && a.head) {
                o(a.head[0] + 2, a.head[1], 1, 2, dark);
                o(a.head[0] + a.head[2] - 3, a.head[1], 1, 2, dark);
                if (a.body) {
                    for (let y = a.body[1] + 1; y < a.body[1] + a.body[3] - 1; y += 2)
                        o(a.body[0] + 1, y, a.body[2] - 2, 1, game.shade(L.base, -0.18));
                }
            }
            if (L.patches && a.head) {
                o(a.head[0], a.head[1], 3, 3, L.patches[0]);
                o(a.head[0] + a.head[2] - 3, a.head[1] + 1, 3, 2, L.patches[1]);
                if (a.body) {
                    o(a.body[0] + a.body[2] - 3, a.body[1] + 1, 3, 3, L.patches[0]);
                    o(a.body[0], a.body[1] + a.body[3] - 3, 2, 2, L.patches[1]);
                }
            }
            if (L.saddle && a.saddle)
                o(a.saddle[0], a.saddle[1], a.saddle[2], a.saddle[3], L.saddle);
            if (L.spots) {
                const spots = [[0, 1], [3, 2], [1, 4], [4, 0], [2, 3], [5, 3]];
                for (const r of [a.head, a.body]) {
                    if (!r)
                        continue;
                    for (const s of spots) {
                        if (s[0] < r[2] && s[1] < r[3])
                            o(r[0] + s[0], r[1] + s[1], 1, 1, dark);
                    }
                }
            }
            if (L.chest && a.chest)
                o(a.chest[0], a.chest[1], a.chest[2], a.chest[3], L.light);
            if (L.muzzle && a.muzzle)
                o(a.muzzle[0], a.muzzle[1], a.muzzle[2], a.muzzle[3], L.light);
            if (L.mask && a.mask)
                o(a.mask[0], a.mask[1] + 1, a.mask[2], a.mask[3], L.light);
            if (L.face && a.mask)
                o(a.mask[0] + 1, a.mask[1] + 1, a.mask[2] - 2, a.mask[3], L.face);
            if (L.points) {
                if (a.mask)
                    o(a.mask[0] + 1, a.mask[1] + 1, a.mask[2] - 2, a.mask[3], game.shade(L.points, 0.15));
                for (const p of a.paws ?? [])
                    o(p[0], p[1], p[2], p[3], L.points);
            }
        }

        // Draws a whole sprite sheet into a canvas: 16×24 frames on an 18×26 grid,
        // so a scaled frame never samples the frame next to it.
        // A mover's sheet: standing and two walking frames, empty-handed and then
        // carrying, in the four directions.
        function paintMoverSheet(ctx, look) {
            ctx.clearRect(0, 0, 108, 104);
            const carrying = Object.assign({}, look, {
                carry: true
            });
            for (const d of [0, 1, 3]) {
                for (let f = 0; f < 6; f++) {
                    const parts = humanFrame(f < 3 ? look : carrying, f % 3, d);
                    paintCell(ctx, parts, f * 18, d * 26, false);
                    if (d === 1)
                        paintCell(ctx, parts, f * 18, 52, true);
                }
            }
        }

        // The desk a mover carries in front of it: a monitor and a chair on it,
        // legs down to the floor. It fits the mover's own figure, so it never
        // covers anyone around it.
        function paintLoad(ctx, chair) {
            ctx.clearRect(0, 0, 16, 14);
            const R = (c, x, y, w, h) => rect(ctx, c, x, y, w, h);
            const O = art.outline;
            R(O, 1, 9, 4, 5);
            R(O, 11, 9, 4, 5);
            R("#7a5530", 2, 10, 2, 4);
            R("#7a5530", 12, 10, 2, 4);
            R(O, 0, 6, 16, 5);
            R("#c99a64", 1, 7, 14, 2);
            R("#8f6538", 1, 9, 14, 1);
            R(O, 1, 0, 9, 7);
            R("#2b2f39", 2, 1, 7, 5);
            R("#141a24", 3, 2, 5, 3);
            R(O, 10, 1, 6, 6);
            R(chair, 11, 2, 4, 4);
            R(game.shade(chair, 0.18), 11, 2, 4, 1);
        }

        function personCell(look, frame, dir) {
            if (!look)
                return [];
            return look.pet ? petFrame(look, frame, dir) : humanFrame(look, frame, dir);
        }

        function paintCell(ctx, parts, ox, oy, mirror) {
            let style = null;
            const fill = (x, y, w, h, c) => {
                if (mirror)
                    x = 16 - x - w;
                const x0 = Math.max(0, x), y0 = Math.max(0, y);
                const x1 = Math.min(16, x + w), y1 = Math.min(24, y + h);
                if (x1 <= x0 || y1 <= y0)
                    return;
                if (c !== style) {
                    ctx.fillStyle = c;
                    style = c;
                }
                ctx.fillRect(ox + x0, oy + y0, x1 - x0, y1 - y0);
            };
            for (const r of parts[0])
                fill(r[0], r[1], r[2], r[3], r[4]);
            for (const r of parts[1])
                fill(r[0] - 1, r[1] - 1, r[2] + 2, r[3] + 2, art.outline);
            for (const r of parts[1])
                fill(r[0], r[1], r[2], r[3], r[4]);
            for (const r of parts[2])
                fill(r[0], r[1], r[2], r[3], r[4]);
        }

        // The icons over a head: a question, a failure, thinking, napping. Each sits
        // in a 16-wide cell of its own, so a scaled icon never samples its neighbour.
        function paintIcons(ctx) {
            ctx.clearRect(0, 0, 64, 11);
            const q = [[2, 0, 4, 1], [1, 1, 2, 2], [5, 1, 2, 3], [4, 4, 2, 1], [3, 5, 2, 2], [3, 8, 2, 2]];
            const bang = [[3, 0, 3, 6], [3, 7, 3, 2]];
            const z = [[1, 1, 6, 1], [5, 2, 2, 1], [4, 3, 2, 1], [3, 4, 2, 1], [2, 5, 2, 1], [1, 6, 6, 1]];
            const icon = (ox, rects, color) => {
                const parts = [[], rects.map(r => r.concat([color])), []];
                paintCell(ctx, parts, ox, 0, false);
            };
            icon(0, q, "#ffd84a");
            icon(16, bang, "#ff5a5a");
            // A thought bubble with three dots.
            paintCell(ctx, [[], [[0, 2, 9, 5, "#ffffff"], [1, 1, 7, 7, "#ffffff"], [1, 8, 2, 1, "#ffffff"]], [[2, 4, 1, 1, "#4b4a57"], [4, 4, 1, 1, "#4b4a57"], [6, 4, 1, 1, "#4b4a57"]]], 32, 0, false);
            icon(48, z, "#9cc8ff");
        }

        // ── Painting the room ───────────────────────────────────────────────────

        function rect(ctx, c, x, y, w, h) {
            ctx.fillStyle = c;
            ctx.fillRect(x, y, w, h);
        }

        // A 3×5 pixel letter, as five rows of three bits (the left one 4), or
        // undefined for one the office has no letter for.
        readonly property var glyphs: ({
                A: [2, 5, 7, 5, 5],
                B: [6, 5, 6, 5, 6],
                C: [3, 4, 4, 4, 3],
                D: [6, 5, 5, 5, 6],
                E: [7, 4, 6, 4, 7],
                F: [7, 4, 6, 4, 4],
                G: [3, 4, 5, 5, 3],
                H: [5, 5, 7, 5, 5],
                I: [7, 2, 2, 2, 7],
                J: [1, 1, 1, 5, 2],
                K: [5, 5, 6, 5, 5],
                L: [4, 4, 4, 4, 7],
                M: [5, 7, 7, 5, 5],
                N: [6, 5, 5, 5, 5],
                O: [2, 5, 5, 5, 2],
                P: [6, 5, 6, 4, 4],
                Q: [2, 5, 5, 7, 3],
                R: [6, 5, 6, 5, 5],
                S: [3, 4, 2, 1, 6],
                T: [7, 2, 2, 2, 2],
                U: [5, 5, 5, 5, 7],
                V: [5, 5, 5, 5, 2],
                W: [5, 5, 7, 7, 5],
                X: [5, 5, 2, 5, 5],
                Y: [5, 5, 2, 2, 2],
                Z: [7, 1, 2, 4, 7],
                "0": [7, 5, 5, 5, 7],
                "1": [2, 6, 2, 2, 7],
                "2": [6, 1, 2, 4, 7],
                "3": [6, 1, 2, 1, 6],
                "4": [5, 5, 7, 1, 1],
                "5": [7, 4, 6, 1, 6],
                "6": [3, 4, 6, 5, 2],
                "7": [7, 1, 1, 2, 2],
                "8": [2, 5, 2, 5, 2],
                "9": [2, 5, 3, 1, 6]
            })

        // The pixel letters of `text`, accents dropped, or null when one has
        // none.
        function letters(text) {
            const out = [];
            for (const ch of String(text).normalize("NFD").replace(/[\u0300-\u036f]/g, "").toUpperCase()) {
                const glyph = art.glyphs[ch];
                if (!glyph)
                    return null;
                out.push(glyph);
            }
            return out;
        }

        // Draws pixel letters (from letters()) at x, y, a column apart.
        function paintLetters(ctx, glyphs, x, y, c) {
            ctx.fillStyle = c;
            glyphs.forEach((glyph, i) => {
                for (let row = 0; row < 5; row++) {
                    for (let col = 0; col < 3; col++) {
                        if (glyph[row] & (4 >> col))
                            ctx.fillRect(x + i * 4 + col, y + row, 1, 1);
                    }
                }
            });
        }

        function sky(hour) {
            if (hour >= 7 && hour < 17)
                return ["#7cc4f2", "#a8dbfa", "#ffffff"];
            if (hour >= 17 && hour < 20)
                return ["#f08a5d", "#f7c08a", "#ffe4b5"];
            if (hour >= 5 && hour < 7)
                return ["#f4a7b9", "#fbd3c0", "#fff1e0"];
            return ["#1d2547", "#2b3566", "#f6f1c7"];
        }

        function paintFloor(ctx, w) {
            if (!w)
                return;
            const W = w.cols * 16, H = w.rows * 16;
            ctx.clearRect(0, 0, W, H);
            const xd = w.xd, bx = w.bx;
            // Carpet in the work area, wooden planks in the break room.
            for (let y = 3; y < w.rows; y++) {
                for (let x = 0; x < w.cols; x++) {
                    if (x < xd) {
                        rect(ctx, (x + y) % 2 ? "#4d5b74" : "#52617b", x * 16, y * 16, 16, 16);
                        rect(ctx, "rgba(255,255,255,0.03)", x * 16, y * 16, 16, 1);
                    } else {
                        const shift = (y % 2) * 8;
                        rect(ctx, y % 2 ? "#b88654" : "#bd8b58", x * 16, y * 16, 16, 16);
                        rect(ctx, "#a2733f", x * 16, y * 16 + 15, 16, 1);
                        rect(ctx, "#a2733f", x * 16 + shift, y * 16 + 2, 1, 13);
                        if ((x * 7 + y * 3) % 5 === 0)
                            rect(ctx, "#c99a66", x * 16 + 3, y * 16 + 6, 3, 1);
                    }
                }
            }
            // A rug under the couch, and one under the table.
            const rug = (x, y, ww, hh, c1, c2) => {
                rect(ctx, c2, x, y, ww, hh);
                rect(ctx, c1, x + 2, y + 2, ww - 4, hh - 4);
                for (let i = x + 4; i < x + ww - 4; i += 6)
                    rect(ctx, c2, i, y + hh / 2 - 1, 3, 2);
            };
            rug((bx + 5) * 16 + 4, 6 * 16 + 8, 5 * 16 - 8, 4 * 16 + 2, "#9b4d5a", "#7a3442");
            rug((bx + 1) * 16 + 2, 7 * 16 + 4, 4 * 16 - 4, 4 * 16 - 6, "#4d7a6b", "#365a4e");
            // The review corner's carpet, green with a border.
            const v = w.review;
            for (let y = v.y; y < v.y + v.h; y++) {
                for (let x = v.x; x < v.x + v.w; x++)
                    rect(ctx, (x + y) % 2 ? "#4b6a5f" : "#507065", x * 16, y * 16, 16, 16);
            }
            rect(ctx, "#3b5449", v.x * 16, v.y * 16, v.w * 16, 2);
            rect(ctx, "#3b5449", v.x * 16, (v.y + v.h) * 16 - 2, v.w * 16, 2);
            rect(ctx, "#3b5449", v.x * 16, v.y * 16, 2, v.h * 16);
            // Shadow under the top wall.
            rect(ctx, "rgba(0,0,0,0.18)", 0, 48, W, 3);
            rect(ctx, "rgba(0,0,0,0.08)", 0, 51, W, 3);
            // The top wall.
            rect(ctx, "#4a4038", 0, 0, W, 6);
            rect(ctx, "#ddd3c3", 0, 6, xd * 16, 38);
            rect(ctx, "#e9dcb8", bx * 16, 6, W - bx * 16, 38);
            rect(ctx, "rgba(0,0,0,0.05)", 0, 6, W, 2);
            rect(ctx, "#8a7a68", 0, 44, W, 4);
            rect(ctx, "#a08e7a", 0, 44, W, 1);
            // Windows over the work area, the sky as it is now.
            const colors = sky(new Date().getHours());
            const night = colors[0] === "#1d2547";
            for (let x = 3; x + 3 < xd - 1; x += 7) {
                const wx = x * 16 + 4, wy = 10, ww = 40, wh = 26;
                rect(ctx, "#f4f1ea", wx - 2, wy - 2, ww + 4, wh + 4);
                rect(ctx, colors[0], wx, wy, ww, wh);
                rect(ctx, colors[1], wx, wy + wh - 8, ww, 8);
                if (night) {
                    rect(ctx, colors[2], wx + 7, wy + 5, 1, 1);
                    rect(ctx, colors[2], wx + 29, wy + 9, 1, 1);
                    rect(ctx, colors[2], wx + 18, wy + 3, 1, 1);
                    rect(ctx, colors[2], wx + 33, wy + 4, 3, 3);
                } else {
                    rect(ctx, colors[2], wx + 6 + (x % 3) * 4, wy + 6, 8, 2);
                    rect(ctx, colors[2], wx + 8 + (x % 3) * 4, wy + 5, 4, 1);
                }
                // A skyline at the bottom.
                const city = night ? "#141a33" : "#8aa5bd";
                rect(ctx, city, wx, wy + wh - 6, 8, 6);
                rect(ctx, city, wx + 9, wy + wh - 10, 6, 10);
                rect(ctx, city, wx + 17, wy + wh - 4, 7, 4);
                rect(ctx, city, wx + 26, wy + wh - 8, 5, 8);
                rect(ctx, city, wx + 33, wy + wh - 5, 7, 5);
                if (night) {
                    rect(ctx, "#f6d36b", wx + 11, wy + wh - 8, 1, 1);
                    rect(ctx, "#f6d36b", wx + 28, wy + wh - 6, 1, 1);
                }
                rect(ctx, "#f4f1ea", wx + ww / 2 - 1, wy, 2, wh);
                rect(ctx, "#f4f1ea", wx, wy + 11, ww, 2);
                rect(ctx, "rgba(255,255,255,0.25)", wx + 2, wy + 2, 3, 7);
                rect(ctx, "#cfc8bb", wx - 3, wy + wh + 2, ww + 6, 2);
            }
            // A clock and a poster in the break room.
            const cx = (bx + 4) * 16 + 2, cy = 14;
            rect(ctx, "#2f2a28", cx + 2, cy - 1, 8, 14);
            rect(ctx, "#2f2a28", cx - 1, cy + 2, 14, 8);
            rect(ctx, "#2f2a28", cx, cy, 12, 12);
            rect(ctx, "#fbf8f1", cx + 1, cy + 1, 10, 10);
            rect(ctx, "#fbf8f1", cx + 3, cy, 6, 12);
            rect(ctx, "#fbf8f1", cx, cy + 3, 12, 6);
            rect(ctx, "#2f2a28", cx + 5, cy + 2, 1, 4);
            const hour = new Date().getHours() % 12;
            const hand = [[0, -3], [1, -3], [2, -2], [3, 0], [2, 2], [1, 3], [0, 3], [-1, 3], [-2, 2], [-3, 0], [-2, -2], [-1, -3]][hour];
            rect(ctx, "#c0392b", cx + 5 + Math.sign(hand[0]), cy + 5 + Math.sign(hand[1]), 1, 1);
            rect(ctx, "#c0392b", cx + 5 + hand[0], cy + 5 + hand[1], 1, 1);
            rect(ctx, "#2f2a28", cx + 5, cy + 5, 2, 2);
            const px = (bx + 2) * 16 + 8;
            rect(ctx, "#f2ede4", px - 1, 9, 22, 28);
            rect(ctx, "#e8894a", px, 10, 20, 26);
            rect(ctx, "#f8c25c", px + 4, 14, 12, 12);
            rect(ctx, "#fbe7a1", px + 7, 17, 6, 6);
            rect(ctx, "#3d4451", px + 3, 29, 14, 2);
            // A poster and a framed picture in the work area, between the windows.
            for (let x = 6; x + 3 < xd - 1; x += 14) {
                const qx = x * 16 + 14;
                rect(ctx, "#2f2a28", qx - 1, 11, 16, 22);
                rect(ctx, "#4a90d9", qx, 12, 14, 20);
                rect(ctx, "#f2efe8", qx + 3, 16, 8, 3);
                rect(ctx, "#f2efe8", qx + 5, 21, 4, 8);
            }
            // The review corner's sign, on the wall beside its whiteboard.
            const sx = (xd - 2) * 16 + 1, sy = 14;
            rect(ctx, "#2f2a28", sx + 6, sy - 5, 1, 5);
            rect(ctx, "#2f2a28", sx + 23, sy - 5, 1, 5);
            rect(ctx, art.outline, sx - 1, sy - 1, 32, 13);
            rect(ctx, "#2f7a55", sx, sy, 30, 11);
            rect(ctx, "#3f9a6c", sx, sy, 30, 1);
            paintLetters(ctx, art.letters("REVIEW"), sx + 4, sy + 3, "#f2efe8");
            // A check mark under it.
            for (const [dx, dy] of [[0, 1], [1, 2], [2, 1], [3, 0], [4, -1]])
                rect(ctx, "#5fd38a", sx + 12 + dx, sy + 20 + dy, 2, 2);
            // The side, bottom and middle walls.
            const wall = (x, y, ww, hh) => {
                rect(ctx, "#4a4038", x, y, ww, hh);
                rect(ctx, "#5d544b", x + 2, y, ww - 4, hh);
                rect(ctx, "#6c6258", x + 3, y, ww - 6, 1);
            };
            wall(0, 40, 16, H - 40);
            wall(W - 16, 40, 16, H - 40);
            rect(ctx, "#4a4038", 0, H - 16, W, 16);
            rect(ctx, "#5d544b", 0, H - 14, W, 12);
            rect(ctx, "#6c6258", 0, H - 14, W, 1);
            wall(xd * 16, 6, 16, 5 * 16 - 6);
            wall(xd * 16, 7 * 16, 16, H - 7 * 16);
            // The door to the break room, and a mat at the way in.
            rect(ctx, "#8a6a48", xd * 16, 5 * 16, 2, 32);
            rect(ctx, "#8a6a48", xd * 16 + 14, 5 * 16, 2, 32);
            rect(ctx, "rgba(0,0,0,0.12)", xd * 16 + 2, 5 * 16, 12, 32);
            const e = w.entrance;
            rect(ctx, "#6b4a2f", e[0] * 16 - 8, (e[1] + 1) * 16 - 2, 32, 4);
            rect(ctx, "#3f6b5c", e[0] * 16 - 6, e[1] * 16 + 4, 28, 10);
            rect(ctx, "#4f8070", e[0] * 16 - 4, e[1] * 16 + 6, 24, 6);
        }
    }

    // One thing an Actor can do. An actor does the first of its activities whose
    // `when` is true, and looks again when that changes or a stay ends.
    component Activity: QtObject {
        // Its name, the actor's `plan`. A name that changes is a different plan.
        property string name: ""
        property bool when: true

        // Where it is done, one of: a kind of Spot, a tile [x, y], a random tile,
        // or whatever `goal(actor)` returns.
        property string spot: ""
        property var at: null
        property bool wander: false
        property var goal: null

        // The Pose shown there; a Spot's own when empty.
        property string pose: ""
        // How long it stays, in ms: a number, or [least, most]. Forever when null.
        property var stay: null
        // Whether the stay waits for the goal, or starts wherever the actor stops.
        property bool mustArrive: true
        // Whether the stay counts only at a seat: resting is sitting, not waiting.
        property bool mustSit: false
        // Plans this one leaves running.
        property var keep: []

        // Every time it is the activity to do, whether or not that is a change.
        signal chosen(var actor)
        // The stay is over. The actor decides again unless the handler already
        // gave it something to do or a later `until`.
        signal ended(var actor)
    }

    // Someone in a World. It does the first of its `activities` whose `when` is
    // true, walking to where that is done. Its children are what it looks like;
    // `overhead` is above its head, in screen pixels and over everything.
    component Actor: Item {
        id: actor

        readonly property bool isActor: true
        property var world: {
            let above = parent;
            while (above && above.world === undefined)
                above = above.parent;
            return above?.world ?? null;
        }
        property var crowd: null
        property string key: ""
        // What a Crowd made it for.
        property var entry: null
        // Moved by you (step(), show()), not by the world's clock.
        property bool manual: false
        property bool gone: false

        // Where it starts, and then where it is: the tile, and in art pixels.
        property int tx: -1
        property int ty: -1
        property real px: 0
        property real py: 0
        readonly property int tile: world?.tile ?? 16

        property list<QtObject> activities
        // A list, not an alias: older Ljós lost a child given through one.
        property list<Item> overhead

        // Frames, for a Sheet bound to `frame` and `dir`.
        property var walkFrames: [0]
        property int standFrame: 0
        property int sitFrame: standFrame
        property int talkFrame: standFrame
        // function(goal, time) → a frame, or null for the goal's Pose.
        property var frameFor: null
        // function(talk) → what it answers when talked to.
        property var reply: talk => "!"
        property real headX: width / 2
        property real headY: 0
        // What is over its head among the others': a bubble above icons.
        property real headZ: bubble ? 2 : 1
        property string bubbleName: ""
        // Art pixels a second.
        property real speed: 50

        // What it is doing.
        property string plan: ""
        property var goal: null
        property var path: []
        property int next: -1
        property int claim: -1
        property int hold: -1
        property real until: 0
        property var stay: null
        property int frame: 0
        property int dir: 0
        property real dist: 0
        property real offY: 0
        property var talk: null
        property var queue: []
        property string heldBy: ""
        property int face: -1
        property string bubble: ""
        property real bubbleUntil: 0
        property var doing: null
        property bool due: true

        readonly property bool stopped: next < 0 && path.length === 0
        readonly property bool arrived: goal !== null && stopped && tx === goal.x && ty === goal.y
        readonly property var wanted: {
            for (let i = 0; i < activities.length; i++) {
                if (activities[i].when)
                    return activities[i];
            }
            return null;
        }
        readonly property string wantedPlan: wanted?.name ?? ""

        // It got to its goal.
        signal reached(var goal)

        width: tile
        height: tile
        x: px
        y: py - (height - tile) + offY
        z: py + tile
        visible: tx >= 0

        onWantedChanged: wake()
        onWantedPlanChanged: wake()

        function wake() {
            due = true;
            if (world && tx >= 0)
                world.walking = true;
        }

        Component.onCompleted: {
            for (let i = 0; i < overhead.length; i++)
                overhead[i].parent = head;
            if (!world)
                return;
            if (tx >= 0) {
                px = tx * tile;
                py = ty * tile;
            }
            world.join(actor);
        }
        Component.onDestruction: world?.leave?.(actor)

        function choice() {
            for (let i = 0; i < activities.length; i++) {
                if (activities[i].when)
                    return activities[i];
            }
            return null;
        }

        function goalOf(activity) {
            if (activity.goal)
                return activity.goal(actor);
            if (activity.spot)
                return world.spotFor(actor, activity.spot, activity.pose);
            let tileAt = activity.at;
            if (activity.wander)
                tileAt = world.nearestFree(Math.floor(world.rng() * world.columns), Math.floor(world.rng() * world.rows), key);
            if (!tileAt || !world.walkable(tileAt[0], tileAt[1]))
                return null;
            const spot = { x: tileAt[0], y: tileAt[1], face: 0, offY: 0, pose: activity.pose, kind: activity.name };
            if (!world.free(spot, actor))
                return null;
            world.claim(actor, spot);
            return spot;
        }

        // Works out what to do, and goes to do it when that changed or `force`.
        function decide(force) {
            if (!world)
                return;
            due = false;
            if (talk)
                return;
            // As `when` is now, which can be ahead of `wanted`.
            const activity = choice();
            if (!activity)
                return;
            activity.chosen(actor);
            if (!force && goal && (plan === activity.name || activity.keep.includes(plan)))
                return;
            begin(activity);
        }

        // Does an activity now, whatever its `when` says.
        function begin(activity) {
            const to = goalOf(activity);
            doing = activity;
            stay = activity.stay;
            until = Infinity;
            plan = activity.name;
            setGoal(to);
        }

        function setGoal(to) {
            const same = goal && to && goal.x === to.x && goal.y === to.y;
            goal = to;
            // Nowhere to go: the old walk is dropped, and a step already under way
            // ends where it was going. The actor keeps the tile it stops on, so
            // nobody else stops there too, or lets go of a claim when it cannot.
            if (!to) {
                path = [];
                const at = next >= 0 ? next : tx >= 0 ? ty * world.columns + tx : -1;
                const here = at >= 0 ? { x: at % world.columns, y: Math.floor(at / world.columns) } : null;
                if (here && world.free(here, actor))
                    world.claim(actor, here);
                else
                    world.release(actor);
                return;
            }
            if (tx < 0)
                return;
            if (!same || (path.length === 0 && next < 0 && (tx !== to.x || ty !== to.y)))
                route();
            world.walking = true;
        }

        // Walks to a tile, or the nearest free one to it. False when there is none.
        function walkTo(x, y) {
            const to = world.walkable(x, y) && world.free({ x: x, y: y }, actor) ? [x, y] : world.nearestFree(x, y, key);
            if (!to)
                return false;
            const spot = { x: to[0], y: to[1], face: 0, offY: 0, pose: "", kind: "walk" };
            world.claim(actor, spot);
            doing = null;
            stay = null;
            plan = "walk";
            setGoal(spot);
            if (stopped && tx === spot.x && ty === spot.y)
                reached(goal);
            return true;
        }

        // Walks up to another actor to say something. The line's id, for reword().
        function tell(other, text, kind) {
            const id = ++world.made;
            queue.push({ id: id, to: typeof other === "string" ? other : other.key, text: text, kind: kind });
            world.walking = true;
            return id;
        }

        // New words for a line it waits to say, walks over to say, or is saying.
        function reword(id, text) {
            for (const line of queue) {
                if (line.id === id)
                    line.text = text;
            }
            if (!talk || talk.id !== id)
                return;
            talk.text = world.talks.spoken(text);
            if (talk.phase === "say")
                bubble = talk.text;
        }

        function say(text, ms) {
            bubble = text;
            bubbleUntil = world.now + (ms ?? 3000);
        }

        // Plans from its tile, or the one it is stepping onto.
        function route() {
            if (!goal || tx < 0)
                return;
            const W = world.columns;
            const sx = next >= 0 ? next % W : tx;
            const sy = next >= 0 ? (next - sx) / W : ty;
            path = world.path(sx, sy, goal.x, goal.y) ?? [];
        }

        // Puts it on a tile. Off the floor, or with `snap` on something that is
        // not where it is going, on the nearest free floor.
        function place(x, y, snap) {
            const W = world.columns;
            const inside = x >= 0 && y >= 0 && x < W && y < world.rows;
            if (!inside || snap && !(world.walkable(x, y) || (goal && goal.x === x && goal.y === y))) {
                const spare = world.nearestFree(x, y, key) ?? world.entrance;
                x = spare[0];
                y = spare[1];
            }
            tx = x;
            ty = y;
            px = x * tile;
            py = y * tile;
            next = -1;
        }

        // One tick of deciding.
        function think() {
            const talks = world.talks;
            if (!talk && queue.length && tx >= 0 && !talks.held(actor))
                talks.begin(actor);
            if (talk) {
                talks.step(actor);
            } else if (tx >= 0) {
                if (due)
                    decide(false);
                else if (!goal && world.ticks % 8 === 0)
                    decide(true);
                else if (staying())
                    linger();
            }
            if (bubble && world.now >= bubbleUntil && !(talk && talk.phase === "say"))
                bubble = "";
        }

        // Whether the stay of what it is doing counts now.
        function staying() {
            if (!doing || !goal || stay === null || next >= 0 || path.length)
                return false;
            // Sitting is being on the seat, wherever a stay that need not arrive starts.
            if (doing.mustSit && !(goal.seat && tx === goal.x && ty === goal.y))
                return false;
            return !doing.mustArrive || (tx === goal.x && ty === goal.y);
        }

        function linger() {
            if (until === Infinity) {
                until = world.now + (typeof stay === "number" ? stay : world.between(world.rng, stay[0], stay[1]));
                return;
            }
            if (world.now < until)
                return;
            const over = doing, was = until;
            over.ended(actor);
            if (doing === over && until === was)
                decide(true);
        }

        // One tick along its path. It walks through others, and stops only on a
        // tile of its own.
        function step(dt) {
            const W = world.columns;
            if (next < 0 && path.length && world.talks.held(actor))
                return false;
            if (next < 0 && path.length) {
                const n = path.shift();
                next = n;
                const toX = n % W, toY = (n - toX) / W;
                dir = toX < tx ? 1 : toX > tx ? 2 : toY < ty ? 3 : 0;
                offY = 0;
            }
            if (next < 0)
                return false;
            const nx = next % W, ny = (next - nx) / W;
            const stride = Math.max(1, Math.round(dt * speed / 1000));
            const toPx = nx * tile, toPy = ny * tile;
            px += Math.sign(toPx - px) * Math.min(stride, Math.abs(toPx - px));
            py += Math.sign(toPy - py) * Math.min(stride, Math.abs(toPy - py));
            dist += stride;
            if (px === toPx && py === toPy) {
                tx = nx;
                ty = ny;
                next = -1;
                if (path.length === 0 && goal && tx === goal.x && ty === goal.y)
                    reached(goal);
            }
            return true;
        }

        // The frame for what it is doing.
        function show() {
            if (next >= 0) {
                frame = walkFrames[Math.floor(dist / 5) % walkFrames.length];
                return;
            }
            if (talk && talk.phase !== "go") {
                frame = talk.phase === "say" && Math.floor(world.now / 300) % 2 ? talkFrame : standFrame;
                return;
            }
            const at = !!goal && tx === goal.x && ty === goal.y && path.length === 0;
            if (bubble && !talk) {
                frame = Math.floor(world.now / 300) % 2 ? talkFrame : at && goal.seat ? sitFrame : standFrame;
                if (face >= 0)
                    dir = face;
                return;
            }
            if (!at) {
                frame = standFrame;
                if (face >= 0)
                    dir = face;
                return;
            }
            dir = face >= 0 ? face : goal.face ?? 0;
            offY = goal.offY ?? 0;
            let shown = frameFor ? frameFor(goal, world.now) : null;
            if (shown === null || shown === undefined) {
                shown = goal.seat ? sitFrame : standFrame;
                const poses = world.poses;
                for (let i = 0; i < poses.length; i++) {
                    if (poses[i].name === goal.pose) {
                        shown = poses[i].frameAt(world.now);
                        break;
                    }
                }
            }
            frame = shown;
        }

        Item {
            id: head

            readonly property var world: actor.world

            parent: actor.world?.overlayItem ?? actor
            visible: actor.visible
            x: (actor.x + actor.headX) * (world?.pixelScale ?? 1)
            y: (actor.y + actor.headY) * (world?.pixelScale ?? 1)
            z: actor.headZ

            Rectangle {
                id: speech

                objectName: actor.bubbleName
                visible: actor.bubble !== ""
                x: Math.max(-head.x, Math.min((head.parent?.width ?? 0) - head.x - width, -width / 2))
                y: -height - 3 * (head.world?.pixelScale ?? 1)
                width: Math.min(220, speechText.implicitWidth + 16)
                height: speechText.implicitHeight + 10
                color: "#fbf8f1"
                border.color: "#211d2a"
                border.width: 2

                Text {
                    id: speechText

                    anchors.centerIn: parent
                    width: Math.min(204, implicitWidth)
                    text: actor.bubble
                    textFormat: Text.PlainText
                    color: "#211d2a"
                    wrapMode: Text.Wrap
                    maximumLineCount: 3
                    elide: Text.ElideRight
                    font.pixelSize: Math.round(12 * (head.world?.fontScale ?? 1))
                    font.weight: Font.Medium
                }

                Rectangle {
                    x: -speech.x - 4
                    y: speech.height - 2
                    width: 8
                    height: 4
                    color: "#fbf8f1"
                    border.color: "#211d2a"
                    border.width: 2
                }

                Rectangle {
                    x: -speech.x - 2
                    y: speech.height - 2
                    width: 4
                    height: 3
                    color: "#fbf8f1"
                }
            }
        }
    }

    // A picture painted once, and again only when what draws it changes. `draw`
    // is a list of [x, y, width, height, color], or a function(ctx, width, height).
    // It fills its parent unless given a size.
    component Art: Canvas {
        id: art

        property var draw: []
        // Change it to paint again when a `draw` function's inputs change.
        property var key: null

        width: parent ? parent.width : 0
        height: parent ? parent.height : 0
        smooth: false
        antialiasing: false
        onDrawChanged: requestPaint()
        onKeyChanged: requestPaint()
        onPaint: {
            const ctx = getContext("2d");
            ctx.clearRect(0, 0, width, height);
            if (typeof draw === "function") {
                draw(ctx, width, height);
                return;
            }
            for (const part of draw ?? []) {
                ctx.fillStyle = part[4];
                ctx.fillRect(part[0], part[1], part[2], part[3]);
            }
        }
    }

    // One Actor, described inside it, for each entry of `model`: a list of
    // objects with an `id` (see `role`), a list of strings, or a number.
    // Each gets the `key` and `entry` it was made for.
    component Crowd: Item {
        id: crowd

        default property Component delegate
        readonly property var world: {
            let above = parent;
            while (above && above.world === undefined)
                above = above.parent;
            return above?.world ?? null;
        }
        property var model: null
        property string role: "id"
        // Keyed by the model's keys, so with no inherited keys such as "constructor".
        property var members: Object.create(null)
        property int count: 0
        property bool built: false

        function list(entries) {
            return typeof entries === "number" ? Array.from({ length: entries }, (_, i) => i) : entries ?? [];
        }
        function keyOf(entry) {
            return String(typeof entry === "object" ? entry[role] : entry);
        }

        // Lets go of whoever is not in `entries`.
        function keep(entries) {
            const wanted = Object.create(null);
            for (const entry of list(entries))
                wanted[keyOf(entry)] = true;
            const left = [];
            for (const key of Object.keys(members)) {
                if (wanted[key])
                    continue;
                left.push(members[key]);
                delete members[key];
            }
            count -= left.length;
            // Whoever hears of one leaving may sync again: all are out by then.
            for (const gone of left) {
                if (!gone)
                    continue;
                world?.leave(gone);
                world?.dropSheets(gone);
                gone.visible = false;
                gone.parent = null;
                gone.destroy();
            }
        }

        // Makes whoever is new in `entries`, and gives the rest their new entry.
        function fill(entries) {
            if (!delegate || !world)
                return;
            for (const entry of list(entries)) {
                const key = keyOf(entry);
                if (members[key]) {
                    members[key].entry = entry;
                    continue;
                }
                const made = delegate.createObject(crowd.parent, {
                    key: key,
                    entry: entry,
                    world: world,
                    crowd: crowd
                });
                if (made) {
                    members[key] = made;
                    count++;
                }
            }
        }

        function sync(entries) {
            keep(entries);
            fill(entries);
        }

        onModelChanged: if (built) sync(model)
        Component.onCompleted: {
            built = true;
            if (model !== null)
                sync(model);
        }
        Component.onDestruction: if (world?.leave) keep([])
    }

    // The frames an Actor shows while it stands at a goal with this pose's name.
    component Pose: QtObject {
        property string name: ""
        property var frames: [0]
        // Milliseconds a frame, or one number per frame.
        property var every: 300

        // The frame at `time`, in world milliseconds.
        function frameAt(time) {
            if (frames.length < 2)
                return frames[0] ?? 0;
            if (typeof every === "number")
                return frames[Math.floor(time / every) % frames.length];
            let round = 0;
            for (let i = 0; i < frames.length; i++)
                round += every[i];
            let left = time % round;
            for (let i = 0; i < frames.length; i++) {
                left -= every[i];
                if (left < 0)
                    return frames[i];
            }
            return frames[0];
        }
    }

    // A sprite sheet, painted once in the World's paint budget and then only moved.
    // `draw(frame, row)` returns rects [x, y, width, height, color], or three
    // lists of them: [under, outlined, over]. Draw the side row facing left.
    component Sheet: Item {
        id: sheet

        readonly property var world: {
            let above = parent;
            while (above && above.world === undefined)
                above = above.parent;
            return above?.world ?? null;
        }
        property int columns: 1
        property int rows: 1
        property int cellWidth: 16
        property int cellHeight: 16
        // Between cells, so a scaled one never samples the next.
        property int gap: 2
        property int frame: 0
        // 0 down, 1 left, 2 right, 3 up, as an Actor's `dir`.
        property int facing: 0
        property int row: rows >= 3 ? [0, 1, 1, 2][facing] : 0
        property bool mirrored: facing === 2
        property var draw: (frame, row) => []
        property var key: null
        property color outline: "#211d2a"

        property string painting: ""
        readonly property bool paintable: canvas.available

        width: cellWidth
        height: cellHeight
        clip: true

        function requestSheet() {
            canvas.requestPaint();
        }
        function requeue() {
            if (!world)
                return;
            world.dropSheet(sheet);
            world.queueSheet(sheet);
        }
        onKeyChanged: if (painting) requeue()
        Component.onCompleted: requeue()
        Component.onDestruction: world?.dropSheet?.(sheet)

        function paintCell(ctx, parts, left, top) {
            let style = "";
            const fill = (x, y, w, h, color) => {
                const x0 = Math.max(0, x), y0 = Math.max(0, y);
                const x1 = Math.min(cellWidth, x + w), y1 = Math.min(cellHeight, y + h);
                if (x1 <= x0 || y1 <= y0)
                    return;
                if (color !== style) {
                    ctx.fillStyle = color;
                    style = color;
                }
                ctx.fillRect(left + x0, top + y0, x1 - x0, y1 - y0);
            };
            const layered = parts.length > 0 && (parts[0].length === 0 || typeof parts[0][0] !== "number");
            for (const r of layered ? parts[0] : parts)
                fill(r[0], r[1], r[2], r[3], r[4]);
            if (!layered)
                return;
