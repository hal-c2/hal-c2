                        deskY: north ? y0 + 1 : y0 + 2,
                        face: north ? 0 : 3,
                        offY: north ? 5 : -3,
                        pod: index,
                        chair: chair,
                        screen: north ? "" : index + ":" + i,
                        state: "out",
                        mover: ""
