                    // facing us, or on the back of the chair facing away.
                    marks.push({
                        key: "mark:" + seat.index,
                        seat: seat.index,
                        x: seat.x * 16 + 3,
                        y: north ? seat.deskY * 16 + 4 : seat.y * 16 + 5,
                        w: 9,
                        h: 7,
                        z: north ? (y0 + 3) * 16 + 1 : (y0 + 4) * 16 + 2
                    });
                }
            }
            placed.push({
                x: x,
                y: y0,
                cols: podCols,
                members: [],
                seats: podSeats,
                review: index === corner
            });
            for (const seat of podSeats)
                seats.push(seat);
        }

