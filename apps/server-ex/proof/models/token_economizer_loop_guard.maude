sload model-checker

--- TokenEconomizer's loop guard (plugins/token-economizer/mc): one thread's turns, run
--- one after another by the MC, heard by the plugin's process through its feed, which
--- may miss an event and say so with the next one. The plugin folds each call into the
--- turn's guard, which may find the turn stuck by its free rules, or put a job out to
--- the paid judge, whose verdict comes back later, or never. A stuck turn is redirected
--- up to the budget, each redirect starting a fresh segment, and is then offered a stop,
--- which only the person takes. Redirects and notices are delivered by a task of their
--- own, so they may land after the turn they are about has ended or the next has begun.
--- When a turn closes, one that ended green and was heard whole teaches the project's
--- envelope. proof/hal_c2/token_economizer_loop_guard_proof_test.exs maps it to the code
--- and checks it.
---
--- cfg(Keyed, Reset, Once, Stale, Aimed, First, Whole, Green, Window) switches each part of the
--- design on, so that the design without it can be shown to fail (see the test's
--- moduledoc for the counterexamples):
---   Keyed - a verdict is kept only for the job out now (Turn.verdict/3), and only for
---           the turn under way.
---   Reset - a redirect starts its segment without the job out or the verdict back,
---           in Turn.after_nudge/1.
---   Once  - after the stop offer the guard decides nothing more in the turn, and the
---           plugin offers a turn a stop once (abort_delivered).
---   Stale - a job out longer than the judge's stale time stops blocking the next one.
---   Aimed - a redirect names its run and is refused once that run is no longer under
---           way (Host.steer/4's targetRunId and steerOnly).
---   First - the redirect's notice is delivered before the redirect.
---   Whole - a turn under way when the feed missed an event is partial, and teaches
---           nothing.
---   Green - only a turn that ended on its own, green and not offered a stop, teaches.
---   Window - the feed misses the newest event and says so with the next it delivers,
---           which it queued before the missed one; so the turns heard until those
---           queued with it have been heard are partial too (suspect/2).

mod TOKEN-ECONOMIZER-LOOP-GUARD is
  protecting NAT .

  sorts Kind Ev Feed Act Acts Left Job Pend Arr Guard Watch Item Conf Sys .
  subsort Ev < Feed .
  subsort Act < Acts .
  subsort Nat < Left .
  subsort Item < Conf .

  --- A call that ran a check that failed, or anything else (an edit, a check that passed).
  ops fail ok : -> Kind [ctor] .

  --- What the feed brings the plugin, in the MC's order.
  op started : Nat -> Ev [ctor] .
  op called : Nat Kind -> Ev [ctor] .
  op finished : Nat Bool -> Ev [ctor] .
  op noev : -> Feed [ctor] .
  op _;_ : Feed Feed -> Feed [ctor assoc id: noev] .

  --- What a delivery task does, in order: the redirect's notice, the redirect, the notice
  --- offering a stop.
  ops notice steer offer : -> Act [ctor] .
  op done : -> Acts [ctor] .
  op _then_ : Acts Acts -> Acts [ctor assoc id: done] .

  --- The calls a turn makes before its agent may end it, or calls for good.
  op loop : -> Left [ctor] .

  --- A judge job: the run, the segment and the number it was put out for.
  op job : Nat Nat Nat -> Job [ctor] .
  --- The job out, and whether it is still fresh.
  op nojob : -> Pend [ctor] .
  op out : Job Bool -> Pend [ctor] .
  --- The verdict back for the job out, and whether it says stuck.
  op noverdict : -> Arr [ctor] .
  op got : Job Bool -> Arr [ctor] .

  --- A turn's guard: its segment, redirects, stop offers, the job out, the verdict back,
  --- whether the last check it heard failed, whether the turn is partial, and the jobs
  --- it has put out.
  op g : Nat Nat Nat Pend Arr Bool Bool Nat -> Guard [ctor] .
  op fresh : -> Guard .
  eq fresh = g(0, 0, 0, nojob, noverdict, false, false, 0) .

  --- The plugin's turn under way for the thread, if any.
  op free : -> Watch [ctor] .
  op turn : Nat Guard -> Watch [ctor] .

  --- The MC: the next run to start and how many runs, whether a run is under way and the
  --- calls left in it, how many calls each makes, and per run whether its last check
  --- failed and how it ended (by its agent, or stopped by the person).
  op next : Nat -> Item [ctor] .
  op runs : Nat -> Item [ctor] .
  op idle : -> Item [ctor] .
  op active : Nat Left -> Item [ctor] .
  op calls : Left -> Item [ctor] .
  op red : Nat Bool -> Item [ctor] .
  op ended : Nat Bool -> Item [ctor] .
  --- The feed's queue, and how many of the events the plugin hears next may come
  --- before one it missed (after a miss, at least the next one it hears).
  op feed : Feed -> Item [ctor] .
  op gap : Nat -> Item [ctor] .

  --- The plugin: its turn, and the runs whose turn taught the envelope.
  op watching : Watch -> Item [ctor] .
  op taught : Nat -> Item [ctor] .
  --- The judge: a job asked, and its verdict on the way back.
  op asking : Job -> Item [ctor] .
  op verdict : Job Bool -> Item [ctor] .
  --- Deliveries under way, and what landed in the thread: a redirect's notice, a
  --- redirect for one run in another, a redirect that ran as a turn of its own, a stop
  --- offer. early marks a redirect that landed before its notice.
  op task : Nat Acts -> Item .
  op noticed : Nat -> Item [ctor] .
  op steered : Nat Nat -> Item [ctor] .
  op followup : Nat -> Item [ctor] .
  op offered : Nat -> Item [ctor] .
  op early : Nat -> Item [ctor] .
  --- A verdict read in a turn or segment it was not asked for.
  op wrong : Job -> Item [ctor] .

  op cfg : Bool Bool Bool Bool Bool Bool Bool Bool Bool -> Item [ctor] .
  op budget : Nat -> Item [ctor] .
  --- Events the feed may miss, judge jobs that may never answer, and whether a job that
  --- answers may go stale first.
  op faults : Nat -> Item [ctor] .
  op losses : Nat -> Item [ctor] .
  op slow : Bool -> Item [ctor] .
  --- Whether the judge may find a turn productive, and whether every call is a sign of
  --- trouble the free rules leave to the judge (a turn stuck for good).
  op spares : Bool -> Item [ctor] .
  op stuckloop : Bool -> Item [ctor] .

  op empty : -> Conf [ctor] .
  op __ : Conf Conf -> Conf [ctor assoc comm id: empty] .
  op {_} : Conf -> Sys [ctor] .

  vars R R' S S' N O J J' BU F L M : Nat .
  vars KY RS ON ST AM FI WH GR WI B V OK T RD PT SP SL : Bool .
  vars JB JB' : Job .
  var P : Pend .
  var A : Arr .
  var G : Guard .
  var W : Watch .
  var K : Kind .
  var E : Ev .
  var FD : Feed .
  var AS : Acts .
  var LF : Left .
  var C : Conf .

  op len : Feed -> Nat .
  eq len(noev) = 0 .
  eq len(E ; FD) = s len(FD) .

  op dec : Nat -> Nat .
  eq dec(0) = 0 .
  eq dec(s M) = M .

  op runof : Job -> Nat .
  eq runof(job(R, S, J)) = R .

  op about : Job Nat Nat -> Bool .
  eq about(job(R, S, J), R, S) = true .
  eq about(JB, R, S) = false [owise] .

  op watches : Watch Nat -> Bool .
  eq watches(turn(R, G), R) = true .
  eq watches(W, R) = false [owise] .

  op running : Nat Conf -> Bool .
  eq running(R, active(R, LF) C) = true .
  eq running(R, C) = false [owise] .

  --- Whether a job's verdict is still to come.
  op coming : Job Conf -> Bool .
  eq coming(JB, asking(JB) C) = true .
  eq coming(JB, verdict(JB, V) C) = true .
  eq coming(JB, C) = false [owise] .

  op noticed? : Nat Conf -> Bool .
  eq noticed?(R, noticed(R) C) = true .
  eq noticed?(R, C) = false [owise] .

  eq task(R, done) = empty .

  --- missed/2: an event missed marks the turn under way partial.
  op mark : Watch Bool -> Watch .
  eq mark(free, B) = free .
  eq mark(turn(R, g(S, N, O, P, A, RD, PT, J)), B) = turn(R, g(S, N, O, P, A, RD, PT or B, J)) .

  --- The call folded: whether the turn's last check failed (Turn.resolved_proxy/2).
  op see : Watch Kind -> Watch .
  eq see(turn(R, g(S, N, O, P, A, RD, PT, J)), fail) = turn(R, g(S, N, O, P, A, true, PT, J)) .
  eq see(turn(R, g(S, N, O, P, A, RD, PT, J)), ok) = turn(R, g(S, N, O, P, A, false, PT, J)) .

  --- close/3: the turn ends, and teaches if it may.
  op close : Watch Bool Bool Bool -> Conf .
  eq close(free, OK, WH, GR) = empty .
  eq close(turn(R, g(S, N, O, P, A, RD, PT, J)), OK, WH, GR) =
    if (not WH or not PT) and (not GR or (OK and not RD and O == 0)) then taught(R) else empty fi .

  --- act/5: the guard found the turn stuck. Under the budget it redirects, the notice
  --- and the redirect going out in one task, and starts a fresh segment; then it offers
  --- the stop. After the offer it does nothing (Once).
  op act : Watch Nat Bool Bool Bool -> Conf .
  ceq act(turn(R, g(S, N, O, P, A, RD, PT, J)), BU, ON, RS, FI) =
    watching(turn(R, g(S, N, O, P, A, RD, PT, J))) if ON and O > 0 .
  ceq act(turn(R, g(S, N, O, P, A, RD, PT, J)), BU, ON, RS, FI) =
    watching(turn(R, if RS then g(s S, s N, O, nojob, noverdict, RD, PT, J)
                          else g(s S, s N, O, P, A, RD, PT, J) fi))
    task(R, if FI then notice then steer else steer then notice fi)
    if not (ON and O > 0) /\ N < BU .
  eq act(turn(R, g(S, N, O, P, A, RD, PT, J)), BU, ON, RS, FI) =
    watching(turn(R, g(S, N, s O, P, A, RD, PT, J))) task(R, offer) [owise] .

  --- ask_judge/3: a verdict back is read, and acted on if it says stuck; a fresh job
  --- out answers nothing yet; otherwise a new job goes out (the rate limit only spaces
  --- jobs out by calls, which a stuck turn keeps making). A stale job blocks only without
  --- Stale. Nothing after the stop offer (Once).
  op ask : Watch Nat Bool Bool Bool Bool -> Conf .
  ceq ask(turn(R, g(S, N, O, P, A, RD, PT, J)), BU, ON, RS, FI, ST) =
    watching(turn(R, g(S, N, O, P, A, RD, PT, J))) if ON and O > 0 .
  ceq ask(turn(R, g(S, N, O, P, got(JB, V), RD, PT, J)), BU, ON, RS, FI, ST) =
    (if about(JB, R, S) then empty else wrong(JB) fi)
    (if V then act(turn(R, g(S, N, O, nojob, noverdict, RD, PT, J)), BU, ON, RS, FI)
          else watching(turn(R, g(S, N, O, nojob, noverdict, RD, PT, J))) fi)
    if not (ON and O > 0) .
  ceq ask(turn(R, g(S, N, O, out(JB, true), noverdict, RD, PT, J)), BU, ON, RS, FI, ST) =
    watching(turn(R, g(S, N, O, out(JB, true), noverdict, RD, PT, J))) if not (ON and O > 0) .
  ceq ask(turn(R, g(S, N, O, out(JB, false), noverdict, RD, PT, J)), BU, ON, RS, FI, false) =
    watching(turn(R, g(S, N, O, out(JB, false), noverdict, RD, PT, J))) if not (ON and O > 0) .
  eq ask(turn(R, g(S, N, O, P, A, RD, PT, J)), BU, ON, RS, FI, ST) =
    watching(turn(R, g(S, N, O, out(job(R, S, s J), true), A, RD, PT, s J)))
    asking(job(R, S, s J)) [owise] .

  --- handle_info of a verdict: kept for the turn under way, if it is the job out with
  --- Keyed, or while any is out without it.
  op arrive : Watch Job Bool Bool -> Watch .
  ceq arrive(turn(R, g(S, N, O, out(JB', T), A, RD, PT, J)), JB, V, KY) =
    turn(R, g(S, N, O, out(JB', T), got(JB, V), RD, PT, J))
    if runof(JB) == R and (JB == JB' or not KY) .
  eq arrive(W, JB, V, KY) = W [owise] .

  --- A redirect lands: in its run while that is under way; without Aimed, in whichever
  --- run is under way, or as a message that starts a turn.
  op land : Nat Bool Conf -> Conf .
  op under : Conf -> Nat .
  eq under(active(R, LF) C) = R .
  eq under(C) = 0 [owise] .
  eq land(R, AM, C) =
    if running(R, C) then steered(R, R) (if noticed?(R, C) then empty else early(R) fi)
    else if AM then empty
    else if under(C) == 0 then followup(R) else steered(R, under(C)) fi fi fi .

  --- The MC runs the turns. A call waits for room in the feed (its queue is long; a
  --- missed event is a fault).
  crl [start] : { next(R) runs(L) idle calls(LF) feed(FD) C }
    => { next(s R) runs(L) active(R, LF) calls(LF) red(R, false) feed(FD ; started(R)) C }
    if R <= L .
  crl [call] : { active(R, s N) red(R, B) feed(FD) C }
    => { active(R, N) red(R, true) feed(FD ; called(R, fail)) C } if len(FD) < 2 .
  crl [call] : { active(R, s N) red(R, B) feed(FD) C }
    => { active(R, N) red(R, false) feed(FD ; called(R, ok)) C } if len(FD) < 2 .
  crl [call] : { active(R, loop) red(R, B) feed(FD) C }
    => { active(R, loop) red(R, true) feed(FD ; called(R, fail)) C } if len(FD) < 2 .
  --- The agent ends its turn, whenever it does (a turn stuck for good never does).
  rl [finish] : { active(R, N) feed(FD) C } => { idle ended(R, true) feed(FD ; finished(R, true)) C } .
  --- The person stops the turn from the stop offer.
  rl [interrupt] : { active(R, LF) offered(R) feed(FD) C }
    => { idle ended(R, false) offered(R) feed(FD ; finished(R, false)) C } .

  --- The feed misses the newest event, one that found its queue full; the next one it
  --- delivers says so. Without Window only that one marks the turn under way.
  rl [drop] : feed(FD ; E) gap(M) faults(s F) cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI)
    => feed(FD) gap(if WI then max(M, max(len(FD), 1)) else 1 fi) faults(F)
       cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) .

  --- The plugin hears the feed (observe/2), one event at a time.
  rl [hear-start] : { feed(started(R) ; FD) gap(M) watching(W) cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) C }
    => { feed(FD) gap(dec(M)) watching(mark(turn(R, fresh), WI and M > 0))
         close(mark(W, M > 0), false, WH, GR)
         cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) C } .
  rl [hear-finish] : { feed(finished(R, OK) ; FD) gap(M) watching(turn(R, G)) cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) C }
    => { feed(FD) gap(dec(M)) watching(free) close(mark(turn(R, G), M > 0), OK, WH, GR)
         cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) C } .
  crl [hear-other] : feed(called(R, K) ; FD) gap(M) watching(W) => feed(FD) gap(dec(M)) watching(mark(W, M > 0))
    if not watches(W, R) .
  crl [hear-other] : feed(finished(R, OK) ; FD) gap(M) watching(W) => feed(FD) gap(dec(M)) watching(mark(W, M > 0))
    if not watches(W, R) .

  --- A call of the turn under way (fold/7, Turn.fold/6): no sign of trouble; stuck
  --- by the free rules; or a sign of trouble that the judge is asked about.
  rl [calm] : { feed(called(R, K) ; FD) gap(M) watching(turn(R, G)) stuckloop(false) C }
    => { feed(FD) gap(dec(M)) watching(see(mark(turn(R, G), M > 0), K)) stuckloop(false) C } .
  rl [backstop] : { feed(called(R, K) ; FD) gap(M) watching(turn(R, G)) stuckloop(false) budget(BU)
                   cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) C }
    => { feed(FD) gap(dec(M)) stuckloop(false) budget(BU) cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) C
         act(see(mark(turn(R, G), M > 0), K), BU, ON, RS, FI) } .
  rl [judge] : { feed(called(R, K) ; FD) gap(M) watching(turn(R, G)) budget(BU)
                cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) C }
    => { feed(FD) gap(dec(M)) budget(BU) cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) C
         ask(see(mark(turn(R, G), M > 0), K), BU, ON, RS, FI, ST) } .

  --- The judge answers, stuck or (if it may) productive, or never; a job out goes stale,
  --- one that never answers or, if slow, one whose verdict is still to come.
  rl [answer] : asking(JB) => verdict(JB, true) .
  rl [answer] : asking(JB) spares(true) => verdict(JB, false) spares(true) .
  rl [lose] : asking(JB) losses(s F) => losses(F) .
  crl [stale] : { watching(turn(R, g(S, N, O, out(JB, true), A, RD, PT, J))) slow(SL) C }
    => { watching(turn(R, g(S, N, O, out(JB, false), A, RD, PT, J))) slow(SL) C }
    if SL or not coming(JB, C) .
  rl [verdict] : { verdict(JB, V) watching(W) cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) C }
    => { watching(arrive(W, JB, V, KY)) cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) C } .

  --- A delivery task does its next step. A notice lands in its run whether or not that
  --- has ended (Host.notice/5 needs only the run).
  rl [deliver] : task(R, notice then AS) => task(R, AS) noticed(R) .
  rl [deliver] : task(R, offer then AS) => task(R, AS) offered(R) .
  rl [deliver] : { task(R, steer then AS) cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) C }
    => { task(R, AS) cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) C land(R, AM, C) } .

  --- Switches, the budget, the calls each run makes, the runs, the events the feed may
  --- miss, the judge jobs that may never answer, whether one that answers may go stale
  --- first, whether the judge may spare a turn, and whether every call goes to the judge.
  op start : Bool Bool Bool Bool Bool Bool Bool Bool Bool Nat Left Nat Nat Nat Bool Bool Bool -> Sys .
  eq start(KY, RS, ON, ST, AM, FI, WH, GR, WI, BU, LF, L, F, J, SL, SP, B) =
    { next(1) runs(L) idle calls(LF) feed(noev) gap(0) watching(free) faults(F) losses(J)
      slow(SL) spares(SP) stuckloop(B) budget(BU) cfg(KY, RS, ON, ST, AM, FI, WH, GR, WI) } .

  --- A verdict read in a turn or segment it was not asked for.
  op wrongly : Sys -> Bool .
  eq wrongly({ wrong(JB) C }) = true .
  eq wrongly({ C }) = false [owise] .

  --- A redirect landed in another run than its own, or ran as a turn of its own.
  op misaimed : Sys -> Bool .
  ceq misaimed({ steered(R, R') C }) = true if R =/= R' .
  eq misaimed({ followup(R) C }) = true .
  eq misaimed({ C }) = false [owise] .

  --- More redirects than the budget, or more than one stop offer, in a turn.
  op overrun : Sys -> Bool .
  ceq overrun({ watching(turn(R, g(S, N, O, P, A, RD, PT, J))) budget(BU) C }) = true
    if N > BU or O > 1 .
  eq overrun({ C }) = false [owise] .

  --- A redirect landed before the notice that explains it.
  op unexplained : Sys -> Bool .
  eq unexplained({ early(R) C }) = true .
  eq unexplained({ C }) = false [owise] .

  --- The envelope learned a turn that did not end on its own with its last check green.
  op mistaught : Sys -> Bool .
  op green : Nat Conf -> Bool .
  eq green(R, ended(R, true) red(R, false) C) = true .
  eq green(R, C) = false [owise] .
  ceq mistaught({ taught(R) C }) = true if not green(R, C) .
  eq mistaught({ C }) = false [owise] .

  op unsafe : Sys -> Bool .
  eq unsafe(X:Sys) =
    wrongly(X:Sys) or misaimed(X:Sys) or overrun(X:Sys) or unexplained(X:Sys) or mistaught(X:Sys) .

  --- Every run has ended and the feed is empty (a turn whose end the feed missed is
  --- still watched, until the thread's next turn starts).
  op over : Sys -> Bool .
  eq over({ next(s L) runs(L) idle feed(noev) C }) = true .
  eq over({ C }) = false [owise] .

  --- And the plugin has closed every turn.
  op settled : Sys -> Bool .
  eq settled({ watching(free) C }) = over({ watching(free) C }) .
  eq settled({ C }) = false [owise] .
endm

mod TOKEN-ECONOMIZER-LOOP-GUARD-PROPS is
  including TOKEN-ECONOMIZER-LOOP-GUARD .
  including SATISFACTION .
  subsort Sys < State .

  var C : Conf .

  op finished : -> Prop [ctor] .
  eq { C } |= finished = settled({ C }) .
endm
