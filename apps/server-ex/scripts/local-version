#!/usr/bin/env bash
# Prints the version of a local MC build: `<package version>-local.<stamp>.g<commit>`,
# stamped with the commit's time, so machines that build the same commit get the same
# version and can cluster. A checkout with uncommitted changes is no commit's code and
# gets `<package version>-local.<now>`, a version of its own each time.
set -euo pipefail
cd "$(dirname "$0")/.."

package_version="$(node -p 'require("../server/package.json").version')"
if [[ -z "$(git status --porcelain)" ]]; then
  stamp="$(TZ=UTC git log -1 --format=%cd --date=format-local:%Y%m%d%H%M%S)"
  echo "$package_version-local.$stamp.g$(git rev-parse --short=10 HEAD)"
else
  echo "$package_version-local.$(date -u +%Y%m%d%H%M%S)"
fi
