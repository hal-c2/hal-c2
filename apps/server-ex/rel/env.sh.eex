#!/bin/sh
# The script only needs the node's data directory, for the cluster's TLS options.
. "$RELEASE_ROOT/bin/hal-c2-data-dir"

# The release script does not start distribution unless asked for
# (RELEASE_DISTRIBUTION=sname, e.g. to reach the node with `mix hal_c2.upgrade`). The node
# starts it itself to cluster (HalC2.Cluster): it writes its TLS options to the file
# these flags name. The cookie is not a secret; certificates admit members.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
if [ "$RELEASE_DISTRIBUTION" = none ]; then
  export RELEASE_COOKIE=hal_c2
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -proto_dist inet_tls -ssl_dist_optfile $hal_c2_data/cluster/ssl_dist.conf"
fi
