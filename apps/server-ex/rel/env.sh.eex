#!/bin/sh
# Node state lives apart from the Node server's ~/.hal-c2/userdata.
export HALC2_HOME="${HALC2_HOME:-$HOME/.hal-c2/elixir}"

# Distribution is not started by the release script unless asked for
# (RELEASE_DISTRIBUTION=sname, e.g. to reach the node with `mix hal_c2.upgrade`): a
# machine that joined a cluster boots with its own TLS distribution flags.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
if [ -f "$HALC2_HOME/cluster/vm.args" ]; then
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -args_file $HALC2_HOME/cluster/vm.args"
fi
