#!/bin/sh
# The node finds its own directories (lib/hal_c2/paths.ex): HAL_C2_NODE_HOME, else
# HAL_C2_HOME, else the XDG directories. The script only needs the data directory, for
# cluster boot arguments, and resolves it the same way. A root must be absolute and
# not an old home (~/.t3, ~/.hal-c2, or for HAL_C2_NODE_HOME a directory inside one);
# the node migrates from an old home instead of using it.
hal_c2_node_root="${HAL_C2_NODE_HOME%/}"
case "$hal_c2_node_root" in
  "$HOME/.t3" | "$HOME/.t3/"* | "$HOME/.hal-c2" | "$HOME/.hal-c2/"*) hal_c2_node_root="" ;;
  /*) ;;
  *) hal_c2_node_root="" ;;
esac
hal_c2_root="${HAL_C2_HOME%/}"
case "$hal_c2_root" in
  "$HOME/.t3" | "$HOME/.hal-c2") hal_c2_root="" ;;
  /*) ;;
  *) hal_c2_root="" ;;
esac
if [ -n "$hal_c2_node_root" ]; then
  hal_c2_data="$hal_c2_node_root/data"
elif [ -n "$hal_c2_root" ]; then
  hal_c2_data="$hal_c2_root/data/elixir"
else
  case "${XDG_DATA_HOME:-}" in
    /*) hal_c2_data="$XDG_DATA_HOME/hal-c2/elixir" ;;
    *) hal_c2_data="$HOME/.local/share/hal-c2/elixir" ;;
  esac
fi

# Distribution is not started by the release script unless asked for
# (RELEASE_DISTRIBUTION=sname, e.g. to reach the node with `mix hal_c2.upgrade`): a
# machine that joined a cluster boots with its own TLS distribution flags.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
if [ -f "$hal_c2_data/cluster/vm.args" ]; then
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -args_file $hal_c2_data/cluster/vm.args"
fi
