#!/bin/sh
# The node's state directory, exported as HALC2_NODE_HOME for config/runtime.exs.
# HALC2_HOME is the HAL-C2 home shared with the Node server, whose state is under
# userdata/; the node keeps its own under elixir/. T3_HOME (a state directory) and
# T3CODE_HOME (a home) are their names from before the rename, and an install that
# only has ~/.t3/elixir keeps using it.
if [ -z "${HALC2_NODE_HOME:-}" ]; then
  if [ -n "${HALC2_HOME:-}" ]; then
    HALC2_NODE_HOME="$HALC2_HOME/elixir"
  elif [ -n "${T3_HOME:-}" ]; then
    HALC2_NODE_HOME="$T3_HOME"
  elif [ -n "${T3CODE_HOME:-}" ]; then
    HALC2_NODE_HOME="$T3CODE_HOME/elixir"
  elif [ ! -d "$HOME/.hal-c2/elixir" ] && [ -d "$HOME/.t3/elixir" ]; then
    HALC2_NODE_HOME="$HOME/.t3/elixir"
  else
    HALC2_NODE_HOME="$HOME/.hal-c2/elixir"
  fi
fi
export HALC2_NODE_HOME

# Distribution is not started by the release script unless asked for
# (RELEASE_DISTRIBUTION=sname, e.g. to reach the node with `mix hal_c2.upgrade`): a
# machine that joined a cluster boots with its own TLS distribution flags.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-none}"
if [ -f "$HALC2_NODE_HOME/cluster/vm.args" ]; then
  export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -args_file $HALC2_NODE_HOME/cluster/vm.args"
fi
