#!/bin/sh
# Runs the MC under launchd, systemd or a terminal, and starts it again when it
# stops to finish an update (exit status 75). bin/hal_c2 reads releases/start_erl.data
# each time, so the relaunch runs the version the update installed. If that version
# fails to boot, the start_erl.data it replaced is put back and the old one starts.
set -u
here="$(cd "$(dirname "$0")" && pwd)"

# `hal-c2-service install|status|restart|uninstall` manages this release with the user's
# service manager (`HalC2.Service.main/1`); `hal-c2-service cluster ...` the running
# MC's cluster (`HalC2.Cluster.Command`).
case "${1:-}" in
  install | status | restart | uninstall) exec "$here/hal_c2" eval "HalC2.Service.main([\"$1\"])" ;;
  cluster) shift && exec "$here/hal_c2" eval "HalC2.Cluster.Command.main(System.argv())" "$@" ;;
esac

releases="$here/../releases"
export HAL_C2_SERVICE=1

# The service manager stops the MC by signalling this script. The MC gets the signal
# and this script waits for it, so the MC shuts down instead of being killed with
# whatever else is left once this script is gone.
child=
stopping=
trap 'stopping=1; [ -n "$child" ] && kill -TERM "$child" 2>/dev/null' TERM INT

while :; do
  "$here/hal_c2" start "$@" &
  child=$!
  # A signal that arrived before this MC had a pid to send it to.
  [ -n "$stopping" ] && kill -TERM "$child" 2>/dev/null
  # A trapped signal interrupts `wait`; wait again until the MC itself has exited.
  while :; do
    wait "$child"
    status=$?
    kill -0 "$child" 2>/dev/null || break
  done
  [ -n "$stopping" ] && exit "$status"
  [ "$status" -eq 75 ] && continue
  if [ "$status" -ne 0 ] && [ -f "$releases/start_erl.data.previous" ]; then
    mv "$releases/start_erl.data.previous" "$releases/start_erl.data"
    continue
  fi
  exit "$status"
done
