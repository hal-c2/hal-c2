    "react": "19.2.6",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@cucumber/gherkin": "^42.0.1",
    "@cucumber/messages": "^34.2.1",
    "@types/bun": "1.3.14",
    "@types/node": "catalog:",
